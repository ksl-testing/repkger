#!/usr/bin/env bash
# repkger — rootless .pkg installer / inspector for macOS
#
# Unpacks the contents of ANY Apple installer .pkg into locations the current
# user can actually write to (default: keep system locations that are already
# writable, otherwise re-target to ~/ equivalents). No `installer`, no
# admin/escalation, no GUI installer needed.
#
# Commands:
#   repkger inspect <pkg> [--json] [--show-scripts] [--files [N]]
#       Read a .pkg (or .dmg/.zip/.bundle containing a .pkg) like Suspicious
#       Package: components, versions, install locations, BOM file lists,
#       payload sizes, pre/post-install scripts.
#       --files lists up to N BOM entries with their home-mapped destinations.
#   repkger install <pkg> [options]
#       Home-rooted install (see options below). Accepts .pkg, .mpkg, .bundle,
#       .dmg (mounts and finds inner .pkg), .zip (extracts inner .pkg), or a
#       directory containing a .pkg.
#   repkger bom-redo <pkg> [--home DIR] [--out DIR] [--map SRC=DEST ...]
#       Redo the package BOM to no-sudo locations and repack. Accepts .pkg,
#       .mpkg, .bundle, .dmg, .zip, or a directory containing a .pkg.
#       Rebuilds the
#       payload rooted at the mapped ~/ destinations (pkgbuild), so the
#       resulting rootless .pkg/.mpkg extracts DIRECTLY to the mapped
#       locations (no remapping needed) — e.g. /Applications/Unity/Hub/...
#       -> ~/Applications/Unity/Hub/..., the way Unity Hub would install to
#       ~/Applications. Pre/post-install scripts are ADJUSTED (path refs
#       home-mapped to match the new BOM) before being embedded.
#       Default --out: $REPKGER_DATA/rootless.
#       --preview|--list-only  predictive BOM: Suspicious-Package-style preview
#                              of the redone package (every leaf -> mapped root,
#                              predicted BOM entries, script estimates) —
#                              expands but builds/writes nothing.
#       --only PREFIX          targeted multi-level extraction: only payload
#                              paths at/under PREFIX (absolute, or relative to
#                              the component install-location); repeatable.
#   repkger uninstall <pkg-path|name|record> [--yes] [--purge]
#       Reverse a repkger install using its recorded file manifest.
#   repkger list [--json]
#       Show all install records.
#   repkger brew [brew args...]
#       brew wrapper: intercepts `install --cask <name>` for casks whose
#       artifact is a .pkg (e.g. gamemaker) and installs rootlessly instead;
#       passes everything else through to the real brew. Add `--rpkg` to
#       FORCE the rootless strategy for a pkg cask and NEVER fall through to
#       brew's pkg installer (which needs sudo). --rpkg also handles dmg/zip
#       casks that CONTAIN a .pkg/.mpkg (mounted/extracted, inner pkg
#       installed rootlessly, then cleaned up); any other artifact type dies
#       loudly instead of falling through:
#         repkger brew install --cask --rpkg gamemaker
#       (the `brew()` shim from `repkger self-install` lets you type
#        `brew install --cask --rpkg gamemaker` directly).
#   repkger gui [pkg...]
#       Open the Repkger.app GUI (falls back to a plain prompt otherwise).
#   repkger self-install [--bash]
#       Symlink into ~/bin and add a `brewpkg` shell function to ~/.zshrc
#       (or ~/.bashrc with --bash).
#   repkger version | help
#
# Install options:
#   --home <dir>       root used for home-mapped paths (default: $HOME)
#   --home-rooted      force every location to ~/ equivalents (never keep
#                      original system locations, even when writable)
#   --keep-writable    (default) keep a location if the current user can
#                      already write to it (e.g. /Users/Shared); re-target
#                      the rest to ~/
#   --map SRC=DEST     add/override a mapping (repeatable); SRC and DEST are
#                      absolute paths, e.g. --map "/usr/local=$HOME/opt"
#   --only PREFIX      targeted extraction: only payload paths at/under PREFIX
#                      (absolute, or relative to the component install-location)
#   (bom-redo accepts the same --home/--map/--home-rooted/--keep-writable
#    options as install, plus --out for the output directory, --only for
#    targeted multi-level extraction, and --preview/--list-only for the
#    predictive BOM)
#   --list-only        show what would be installed, change nothing
#   --no-sign          skip quarantine stripping and code-sign checks
#                      (stripping removes com.apple.quarantine from each target
#                      AND its parent dir, so later copies don't re-inherit)
#   --run-scripts      run pre/post-install scripts (home-rooted env, opt-in;
#                      default is to record them without running)
#   --clean            re-expand the pkg from scratch
#   --yes              non-interactive (never prompt)
#   --quiet            less output
#
# Records live in $REPKGER_DATA/records (default ~/.repkger/records) and make
# `repkger uninstall` deterministic. Downloads made by `repkger brew` land in
# $REPKGER_DATA/downloads.

set -euo pipefail

REPKGER_VERSION="0.5.1"
REPKGER_DATA="${REPKGER_DATA:-$HOME/.repkger}"
RECORDS_DIR="$REPKGER_DATA/records"
CACHE_DIR="$REPKGER_DATA/cache"
DOWNLOADS_DIR="$REPKGER_DATA/downloads"

# ---------------------------------------------------------------------------
# output helpers
# ---------------------------------------------------------------------------
QUIET=0
say() { [ "$QUIET" -eq 1 ] && return 0; printf '%s\n' "$*"; }
warn() { printf 'WARN: %s\n' "$*" >&2; }
die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

ASSUME_YES=0
confirm() {  # $1 = prompt; 0 = yes, 1 = no
    if [ "$ASSUME_YES" -eq 1 ]; then return 0; fi
    local ans
    printf '%s [y/N] ' "$1" >&2
    IFS= read -r ans || { printf '\n' >&2; return 1; }
    case "$ans" in y|Y|yes|YES) return 0 ;; *) return 1 ;; esac
}

require_cmds() {
    local c
    for c in "$@"; do
        command -v "$c" >/dev/null 2>&1 || die "required tool not found: $c"
    done
}

file_size() {  # $1 = path; bytes (0 if unreadable)
    stat -f%z "$1" 2>/dev/null || stat -c%s "$1" 2>/dev/null || echo 0
}

sha256_of() {  # $1 = path; echoes bare hex (dirs: hash of sorted per-file digests)
    if [ -d "$1" ]; then
        # bundle .mpkg / legacy pkg dir: deterministic content hash (no paths,
        # no mtimes — same contents hash the same regardless of location)
        if command -v shasum >/dev/null 2>&1; then
            find "$1" -type f -print0 2>/dev/null | sort -z | \
                xargs -0 shasum -a 256 2>/dev/null | awk '{print $1}' | sort | \
                shasum -a 256 | awk '{print $1}'
        elif command -v sha256sum >/dev/null 2>&1; then
            find "$1" -type f -print0 2>/dev/null | sort -z | \
                xargs -0 sha256sum 2>/dev/null | awk '{print $1}' | sort | \
                sha256sum | awk '{print $1}'
        else
            echo ""
        fi
        return 0
    fi
    if command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    elif command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    else
        echo ""
    fi
}

now_iso() { date +"%Y-%m-%dT%H:%M:%S%z" 2>/dev/null || date +"%Y-%m-%dT%H:%M:%S"; }

reverse_lines() {  # reverse stdin
    awk '{ a[NR] = $0 } END { for (i = NR; i >= 1; i--) print a[i] }'
}

# ---------------------------------------------------------------------------
# options / state
# ---------------------------------------------------------------------------
HOME_ROOT="$HOME"
KEEP_WRITABLE=1
DO_SIGN=1
RUN_SCRIPTS=0
LIST_ONLY=0
PREVIEW=0                      # bom-redo --preview/--list-only: predictive BOM
CLEAN=0
QUIET=0
VERBOSE=1
DRY=0
declare -a USER_MAPS=()
declare -a ONLY_MATCHES=()       # --only payload prefixes (targeted extraction)
declare -a MERGED_DIRS=()         # exact dirs merged from payloads (for quarantine strip)
declare -a MAPPED_LOCS=()         # mapped install-location dirs per component (deduped)
CASK_STAGE=""                    # brew wrapper: extract dir for dmg/zip containers
CASK_MNT=""                      # brew wrapper: mounted dmg volume
CONTAINER_STAGE=""               # resolve_pkg_input: temp dir for dmg/zip extraction
CONTAINER_MNT=""                 # resolve_pkg_input: mounted dmg volume
declare -a INSTALLED_FILES=()     # "dst<TAB>typ<TAB>mode<TAB>uidgid<TAB>size" — the package's OWN files

HOME_ROOT="${HOME_ROOT%/}"
[ -n "$HOME_ROOT" ] || HOME_ROOT="/"

# ---------------------------------------------------------------------------
# path mapping
# ---------------------------------------------------------------------------
# map_path <abs path> -> echoes the mapped (target) absolute path.
# Order: user --map overrides (longest prefix wins) -> keep-if-writable ->
#        always-keep world-writable dirs -> default home-rooted rules.
map_path() {
    local p="$1" top=""
    local entry src dst best="" bestlen=-1

    [ "$p" = "/" ] && { echo "/"; return 0; }

    # 1) user overrides, longest prefix first
    for entry in ${USER_MAPS[@]+"${USER_MAPS[@]}"}; do
        src="${entry%%=*}"
        case "$p" in
            "$src"|"$src/"*)
                if [ "${#src}" -gt "$bestlen" ]; then best="$entry"; bestlen="${#src}"; fi
                ;;
        esac
    done
    if [ -n "$best" ]; then
        src="${best%%=*}"; dst="${best#*=}"
        echo "${dst}${p#"$src"}"
        return 0
    fi

    # 1b) already under the home root: accessible by definition, never re-map.
    # Needed for installing repkger-redone (rootless) pkgs whose destinations
    # are already ~/..., and it protects homes under /var/folders from the
    # /var default rule below. (--map overrides above still win.)
    if [ "$HOME_ROOT" != "/" ]; then
        case "$p" in
            "$HOME_ROOT"|"$HOME_ROOT"/*) echo "$p"; return 0 ;;
        esac
    fi

    # 2) keep-if-writable (default): the top-level dir of p is writable by us
    top="${p#/}"; top="${top%%/*}"
    if [ "$KEEP_WRITABLE" -eq 1 ] && [ -n "$top" ] && [ -w "/$top" ]; then
        echo "$p"
        return 0
    fi

    # 3) world-writable by design — always keep
    case "$p" in
        /Users/Shared|/Users/Shared/*|/tmp|/tmp/*|/private/tmp|/private/tmp/*)
            echo "$p"; return 0 ;;
    esac

    # 4) default home-rooted rules
    case "$p" in
        /Applications|/Applications/*)            echo "$HOME_ROOT/Applications${p#/Applications}"; return 0 ;;
        /Library|/Library/*)                      echo "$HOME_ROOT/Library${p#/Library}"; return 0 ;;
        /usr/local|/usr/local/*)                  echo "$HOME_ROOT/.local${p#/usr/local}"; return 0 ;;
        /usr|/usr/*)                              warn "mapping $p -> $HOME_ROOT/.usr (not on default PATH)"; echo "$HOME_ROOT/.usr${p#/usr}"; return 0 ;;
        /etc|/etc/*)                              warn "mapping $p -> $HOME_ROOT/etc (system config in home dir)"; echo "$HOME_ROOT/etc${p#/etc}"; return 0 ;;
        /private|/private/*)                      echo "$HOME_ROOT${p#/private}"; return 0 ;;
        /var|/var/*)                              warn "mapping $p -> $HOME_ROOT/var"; echo "$HOME_ROOT/var${p#/var}"; return 0 ;;
        /opt|/opt/*)                              echo "$HOME_ROOT/opt${p#/opt}"; return 0 ;;
        /bin|/bin/*)                              warn "mapping $p -> $HOME_ROOT/bin (not on default PATH)"; echo "$HOME_ROOT/bin${p#/bin}"; return 0 ;;
        /sbin|/sbin/*)                            warn "mapping $p -> $HOME_ROOT/sbin"; echo "$HOME_ROOT/sbin${p#/sbin}"; return 0 ;;
        /*)                                       warn "mapping unknown root path $p -> $HOME_ROOT$p"; echo "$HOME_ROOT$p"; return 0 ;;
        *)                                        echo "$p"; return 0 ;;
    esac
}

# mapping boundary prefixes that matter for tree merging (default + user maps)
map_prefixes() {
    local entry
    echo "/Users/Shared"
    echo "/tmp"
    echo "/private/tmp"
    echo "/Applications"
    echo "/Library"
    echo "/usr/local"
    echo "/usr"
    echo "/etc"
    echo "/private"
    echo "/var"
    echo "/opt"
    echo "/bin"
    echo "/sbin"
    for entry in ${USER_MAPS[@]+"${USER_MAPS[@]}"}; do
        echo "${entry%%=*}"
    done
}

# targeted extraction (--only): payload-walk prefix filters (virtual abs paths)
only_match() {  # $1 = virtual abs path; 0 = path is at/under a requested prefix
    [ "${#ONLY_MATCHES[@]}" -eq 0 ] && return 0
    local op
    for op in ${ONLY_MATCHES[@]+"${ONLY_MATCHES[@]}"}; do
        case "$1" in
            "$op"|"$op/"*) return 0 ;;
        esac
    done
    return 1
}

only_below() {  # $1 = virtual abs path; 0 = a requested prefix lies under it
    local op
    for op in ${ONLY_MATCHES[@]+"${ONLY_MATCHES[@]}"}; do
        case "$op" in
            "$1/"*) return 0 ;;
        esac
    done
    return 1
}

set_only_matches() {  # $1 = component install-location; normalize relative --only prefixes
    [ "${#ONLY_MATCHES[@]}" -gt 0 ] || return 0
    local loc="$1" op
    local -a n=()
    for op in ${ONLY_MATCHES[@]+"${ONLY_MATCHES[@]}"}; do
        case "$op" in
            /*) n+=("$op") ;;
            *)  n+=("${loc%/}/$op") ;;
        esac
    done
    ONLY_MATCHES=("${n[@]}")
}

# ---------------------------------------------------------------------------
# container cleanup (dmg mount / zip extract)
# ---------------------------------------------------------------------------
# safe_rm_rf — remove a directory tree that may contain root-owned files
# (from pkgutil --expand-full). Tries chmod -R +w first, falls back to
# best-effort removal so the caller never fails.
safe_rm_rf() {
    [ -d "$1" ] || return 0
    chmod -R +w "$1" 2>/dev/null || true
    rm -rf "$1" 2>/dev/null || true
}

container_cleanup() {
    if [ -n "$CONTAINER_MNT" ] && [ -d "$CONTAINER_MNT" ]; then
        hdiutil detach "$CONTAINER_MNT" >/dev/null 2>&1 \
            || hdiutil detach -force "$CONTAINER_MNT" >/dev/null 2>&1 || true
    fi
    if [ -n "$CONTAINER_STAGE" ] && [ -d "$CONTAINER_STAGE" ]; then
        safe_rm_rf "$CONTAINER_STAGE"
    fi
    CONTAINER_MNT=""; CONTAINER_STAGE=""
    # also clean up legacy cask vars
    if [ -n "$CASK_MNT" ] && [ -d "$CASK_MNT" ]; then
        hdiutil detach "$CASK_MNT" >/dev/null 2>&1 \
            || hdiutil detach -force "$CASK_MNT" >/dev/null 2>&1 || true
    fi
    if [ -n "$CASK_STAGE" ] && [ -d "$CASK_STAGE" ]; then
        safe_rm_rf "$CASK_STAGE"
    fi
    CASK_MNT=""; CASK_STAGE=""
}

# ---------------------------------------------------------------------------
# resolve_pkg_input — detect .dmg/.zip/.bundle/.pkg/.mpkg/directory input
# and resolve to the actual .pkg file path(s). Sets the global RESOLVED_PKG
# (NOT echoed — because callers invoke this in a context where globals must
# propagate). Also sets CONTAINER_STAGE / CONTAINER_MNT for cleanup.
# Callers should `trap container_cleanup EXIT` after calling this.
# For directories, finds the first .pkg inside.
# ---------------------------------------------------------------------------
RESOLVED_PKG=""
resolve_pkg_input() {
    local input="$1"
    [ -e "$input" ] || die "not found: $input"
    RESOLVED_PKG=""

    # already a .pkg / .mpkg / .bundle — works as-is (flat XAR)
    case "$input" in
        *.pkg|*.mpkg|*.bundle)
            RESOLVED_PKG="$input"
            return 0
            ;;
    esac

    # directory — scan for .pkg inside
    if [ -d "$input" ]; then
        local found
        found=$(find "$input" -maxdepth 4 \( -name '*.pkg' -o -name '*.mpkg' \) 2>/dev/null | head -1)
        if [ -n "$found" ]; then
            RESOLVED_PKG="$found"
        else
            die "no .pkg/.mpkg found inside directory: $input"
        fi
        return 0
    fi

    # .dmg — mount, find inner .pkg, cleanup later
    case "$input" in
        *.dmg)
            require_cmds hdiutil
            CONTAINER_STAGE=$(mktemp -d "${TMPDIR:-/tmp}/repkger-container.XXXXXX")
            CONTAINER_MNT="$CONTAINER_STAGE/mnt"
            mkdir -p "$CONTAINER_MNT"
            hdiutil attach "$input" -nobrowse -readonly -mountpoint "$CONTAINER_MNT" >/dev/null 2>&1 \
                || die "could not mount $input (hdiutil attach failed)"
            printf '%s\n' "  mounted: $CONTAINER_MNT" >&2
            local found
            found=$(find "$CONTAINER_MNT" -maxdepth 4 \( -name '*.pkg' -o -name '*.mpkg' \) 2>/dev/null | head -1)
            if [ -z "$found" ]; then
                container_cleanup
                die "no .pkg/.mpkg found inside $input"
            fi
            printf '%s\n' "  inner pkg: $found" >&2
            RESOLVED_PKG="$found"
            return 0
            ;;
    esac

    # .zip — extract, find inner .pkg, cleanup later
    case "$input" in
        *.zip)
            CONTAINER_STAGE=$(mktemp -d "${TMPDIR:-/tmp}/repkger-container.XXXXXX")
            if command -v unzip >/dev/null 2>&1; then
                unzip -o -q "$input" -d "$CONTAINER_STAGE" >/dev/null 2>&1 \
                    || die "could not unzip $input"
            else
                ditto -x -k "$input" "$CONTAINER_STAGE" >/dev/null 2>&1 \
                    || die "could not unzip $input (ditto)"
            fi
            local found
            found=$(find "$CONTAINER_STAGE" -maxdepth 4 \( -name '*.pkg' -o -name '*.mpkg' \) 2>/dev/null | head -1)
            if [ -z "$found" ]; then
                container_cleanup
                die "no .pkg/.mpkg found inside $input"
            fi
            printf '%s\n' "  inner pkg: $found" >&2
            RESOLVED_PKG="$found"
            return 0
            ;;
    esac

    # .tar / .tar.gz / .tgz / .tar.bz2 — extract, find inner .pkg
    case "$input" in
        *.tar|*.tar.gz|*.tgz|*.tar.bz2|*.tar.xz)
            CONTAINER_STAGE=$(mktemp -d "${TMPDIR:-/tmp}/repkger-container.XXXXXX")
            tar -xf "$input" -C "$CONTAINER_STAGE" 2>/dev/null \
                || die "could not extract $input"
            local found
            found=$(find "$CONTAINER_STAGE" -maxdepth 4 \( -name '*.pkg' -o -name '*.mpkg' \) 2>/dev/null | head -1)
            if [ -z "$found" ]; then
                container_cleanup
                die "no .pkg/.mpkg found inside $input"
            fi
            printf '%s\n' "  inner pkg: $found" >&2
            RESOLVED_PKG="$found"
            return 0
            ;;
    esac

    # unknown — try treating as a raw package (pkgutil/xar may handle it)
    warn "unrecognized input type: $input — attempting to expand as a package"
    RESOLVED_PKG="$input"
}

# ---------------------------------------------------------------------------
# pkg expansion
# ---------------------------------------------------------------------------
expand_pkg() {  # $1 = pkg path; $2 = expand dir; echoes the component root dir
    local pkg="$1" dir="$2"
    if [ -f "$dir/.repkger-expanded" ]; then
        echo "$dir"
        return 0
    fi
    if [ "$CLEAN" -eq 1 ]; then rm -rf "$dir"; fi
    # pkgutil refuses to expand into a pre-existing directory ("File exists")
    rm -rf "$dir"
    mkdir -p "$(dirname "$dir")"
    if [ -d "$pkg" ]; then
        # legacy bundle .mpkg / .pkg (a directory). pkgutil --expand-full
        # refuses bundle pkgs, so expand each inner flat package into a dir
        # (component_dirs scans Contents/Packages/*.pkg dirs).
        mkdir -p "$dir/Contents/Packages"
        [ -f "$pkg/Contents/Distribution" ] && \
            cp "$pkg/Contents/Distribution" "$dir/Contents/Distribution" 2>/dev/null || true
        local inner ok=0 n
        for inner in "$pkg"/Contents/Packages/*.pkg "$pkg"/*.pkg; do
            [ -f "$inner" ] || continue
            n="$dir/Contents/Packages/$(basename "$inner")"
            rm -rf "$n"
            if pkgutil --expand-full "$inner" "$n" >/dev/null 2>&1; then
                ok=1
            elif command -v xar >/dev/null 2>&1 && \
                 mkdir -p "$n" && xar -xf "$inner" -C "$n" >/dev/null 2>&1; then
                ok=1
            else
                warn "could not expand inner package: $inner"
            fi
        done
        : > "$dir/.repkger-expanded"
        find "$dir" -type d -exec chmod +x {} + 2>/dev/null || true
        echo "$dir"
        return 0
    fi
    if command -v pkgutil >/dev/null 2>&1; then
        if pkgutil --expand-full "$pkg" "$dir" >/dev/null 2>&1; then
            : > "$dir/.repkger-expanded"
            find "$dir" -type d -exec chmod +x {} + 2>/dev/null || true
            echo "$dir"
            return 0
        fi
        warn "pkgutil --expand-full failed; falling back to xar (payloads may need manual extraction)"
    fi
    command -v xar >/dev/null 2>&1 || die "no pkgutil and no xar available"
    mkdir -p "$dir"
    xar -xf "$pkg" -C "$dir" || die "failed to expand $pkg"
    : > "$dir/.repkger-expanded"
    # fix directory permissions: some pkgs record dirs with 0644 (no +x)
    # which prevents traversal. Capital X adds +x to dirs only.
    find "$dir" -type d -exec chmod +x {} + 2>/dev/null || true
    echo "$dir"
}

component_dirs() {  # $1 = expand root; echoes dirs with PackageInfo
    local root="$1" c
    # single-component packages expand with the component at the root itself
    [ -f "$root/PackageInfo" ] && { echo "$root"; return 0; }
    # flat component pkgs (Unity names its inner package Unity.pkg.tmp)
    for c in "$root"/*.pkg "$root"/*.pkg.tmp; do
        [ -f "$c/PackageInfo" ] && echo "$c"
    done
    for c in "$root"/Contents/Packages/*.pkg "$root"/*/Contents/Packages/*.pkg; do
        [ -f "$c/PackageInfo" ] && echo "$c"
    done
}

xml_attr() {  # $1 = file; $2 = tag; $3 = attr (BSD sed: no \b word boundary)
    sed -n 's/.*<'$2'[^>]*[[:space:]]'$3'="\([^"]*\)".*/\1/p' "$1" | head -1
}

dist_version() {  # $1 = Distribution file; echoes the first <pkg-ref ... version=...>
    [ -f "$1" ] || return 0
    sed -n 's/.*<pkg-ref[^>]*[[:space:]]version="\([^"]*\)".*/\1/p' "$1" | head -1
}

comp_id()          { xml_attr "$1/PackageInfo" pkg-info identifier; }
comp_version()     { xml_attr "$1/PackageInfo" pkg-info version; }
comp_install_loc() { xml_attr "$1/PackageInfo" pkg-info install-location; }
comp_auth()        { xml_attr "$1/PackageInfo" pkg-info auth; }
comp_files()       { xml_attr "$1/PackageInfo" payload numberOfFiles; }
comp_kbytes()      { xml_attr "$1/PackageInfo" payload installKBytes; }

comp_scripts() {  # $1 = component dir; echoes "name<TAB>size" per script file
    [ -d "$1/Scripts" ] || return 0
    local f
    for f in "$1"/Scripts/*; do
        [ -f "$f" ] || continue
        printf '%s\t%s\n' "$(basename "$f")" "$(file_size "$f")"
    done
}

comp_display_name() {  # $1 comp dir; $2 prod_root; $3 pkg path — human name
    if [ "$1" = "$2" ]; then
        local n; n=$(basename "$3"); echo "${n%.*}"
    else
        echo "$(basename "$1")"
    fi
}

bom_paths() {  # $1 = bom file; echoes rel paths (Applications/... style), 1 per line
    # lsbom fields are tab-separated; the path may itself contain spaces
    lsbom "$1" 2>/dev/null | awk -F'\t' '{print $1}' | sed 's#^\./##'
}

bom_entry_info() {  # $1 = bom file; echoes "path\tmode\tuid/gid\tsize"
    lsbom "$1" 2>/dev/null | awk -F'\t' '{printf "%s\t%s\t%s\t%s\n", $1, $2, $3, $4}'
}

payload_root() {  # $1 = component dir; echoes the payload dir/file if present
    local c="$1"
    if [ -d "$c/Payload" ]; then echo "$c/Payload"; return 0; fi
    if [ -f "$c/Payload" ]; then echo "$c/Payload"; return 0; fi
    if [ -e "$c/Contents/Archive.pax.gz" ]; then echo "$c/Contents/Archive.pax.gz"; return 0; fi
    echo ""
}

# ---------------------------------------------------------------------------
# payload extraction (only needed when --expand-full did not extract, e.g.
# xar fallback or a payload file left behind)
# ---------------------------------------------------------------------------
extract_payload_file() {  # $1 = payload file; $2 = staging dir; 0 on success
    local payload="$1" stage="$2"
    mkdir -p "$stage"
    if (cd "$stage" && gunzip -dc "$payload" | cpio -id -u) >/dev/null 2>&1; then
        return 0
    fi
    if command -v pbzx >/dev/null 2>&1 && (cd "$stage" && pbzx < "$payload" | cpio -id -u) >/dev/null 2>&1; then
        return 0
    fi
    rm -rf "$stage"
    return 1
}

# ---------------------------------------------------------------------------
# tree merge with per-boundary remapping
# ---------------------------------------------------------------------------
# merge_tree <src dir> <virtual abs path of src dir>
# Walks the payload tree, remapping at mapping boundaries, dittoing whole
# subtrees when nothing below them crosses a boundary.
merge_tree() {
    local src="$1" vpath="$2"
    local mapped; mapped=$(map_path "$vpath")
    shopt -s dotglob nullglob
    local c rel vc mc has_boundary=0 b
    for c in "$src"/*; do
        [ -e "$c" ] || continue
        rel="${c##*/}"
        vc="${vpath%/}/$rel"   # avoid "//Applications" when vpath is "/"
        mc=$(map_path "$vc")
        has_boundary=0
        # boundary below vc iff some mapping prefix is a descendant of vc
        while IFS= read -r b; do
            [ -z "$b" ] && continue
            case "$b" in
                "$vc/"*) has_boundary=1; break ;;
            esac
        done < <(map_prefixes)
        # targeted extraction (--only): descend when a requested prefix lies
        # deeper, otherwise merge only subtrees that are at/under a prefix
        if [ "$has_boundary" -eq 1 ] || { [ "${#ONLY_MATCHES[@]}" -gt 0 ] && only_below "$vc"; }; then
            merge_tree "$c" "$vc"
        else
            [ "${#ONLY_MATCHES[@]}" -gt 0 ] && ! only_match "$vc" && continue
            if [ "$DRY" -eq 1 ]; then
                say "  would merge: $vc -> $mc"
                continue
            fi
            mkdir -p "$(dirname "$mc")" 2>/dev/null || true
            if [ -L "$c" ]; then
                # ditto DEREFERENCES a top-level symlink source and copies the
                # target as a real dir (e.g. Unity's top-level
                # "Unity Bug Reporter.app" -> Unity.app/Contents/Helpers/...)
                # — create the link directly so it stays a symlink
                ln -s "$(readlink "$c")" "$mc"
            else
                if ! ditto "$c" "$mc" 2>/dev/null; then
                    # ditto failed (likely root-owned files in expanded payload);
                    # fall back to rsync which ignores ownership
                    rsync -a --no-perms --no-owner --no-group "$c/" "$mc/" 2>/dev/null \
                        || die "failed to copy $c -> $mc (both ditto and rsync failed)"
                fi
            fi
            MERGED_DIRS+=("$mc")
            [ "$VERBOSE" -eq 1 ] && say "  merged: ${mc#$HOME_ROOT/}"
        fi
    done
    shopt -u dotglob nullglob
}

# remember the mapped install-location dir of each component (deduped)
mapped_loc_add() {  # $1 = mapped install-location dir
    local t
    for t in ${MAPPED_LOCS[@]+"${MAPPED_LOCS[@]}"}; do
        [ "$t" = "$1" ] && return 0
    done
    MAPPED_LOCS+=("$1")
}

# Build the list of files this package actually landed on disk, derived from
# the BOM (so the rewrite/sign passes only ever touch the package's own files,
# never pre-existing content in the mapped dirs). Appends
# "dst<TAB>typ<TAB>mode<TAB>uidgid<TAB>size" lines to INSTALLED_FILES.
build_installed_files() {  # $@ = component dirs; rebuilds INSTALLED_FILES from scratch
    INSTALLED_FILES=()
    local c loc2 bomf path mode uidgid sz entry rel vp dst typ payload2
    for c in "$@"; do
        loc2=$(comp_install_loc "$c"); [ -z "$loc2" ] && loc2="/"
        bomf="$c/Bom"
        if [ -f "$bomf" ]; then
            while IFS= read -r entry; do
                [ -z "$entry" ] && continue
                path="${entry%%$'\t'*}"
                [ "$path" = "." ] && continue
                mode=$(printf '%s' "$entry" | cut -d$'\t' -f2)
                uidgid=$(printf '%s' "$entry" | cut -d$'\t' -f3)
                sz=$(printf '%s' "$entry" | cut -d$'\t' -f4)
                rel="${path#./}"
                if [ "$loc2" = "/" ]; then vp="/$rel"; else vp="$loc2/$rel"; fi
                dst=$(map_path "$vp")
                # pkgutil folds ._* AppleDouble entries into xattrs, so they
                # never land on disk — record only what actually exists
                [ -e "$dst" ] || [ -L "$dst" ] || continue
                typ="file"
                case "$mode" in
                    12*) typ="symlink" ;;
                    4*)  typ="dir" ;;
                esac
                INSTALLED_FILES+=("$dst"$'\t'"$typ"$'\t'"$mode"$'\t'"$uidgid"$'\t'"$sz")
            done < <(bom_entry_info "$bomf")
        else
            payload2=$(payload_root "$c")
            if [ -d "$payload2" ]; then
                local f2
                while IFS= read -r -d '' f2; do
                    rel="${f2#"$payload2"/}"
                    if [ "$loc2" = "/" ]; then vp="/$rel"; else vp="$loc2/$rel"; fi
                    dst=$(map_path "$vp")
                    typ="file"
                    [ -d "$f2" ] && typ="dir"
                    [ -L "$f2" ] && typ="symlink"
                    INSTALLED_FILES+=("$dst"$'\t'"$typ"$'\t\t\t')
                done < <(find "$payload2" -print0)
            fi
        fi
    done
}

# ---------------------------------------------------------------------------
# path rewrite pass (stale /Applications etc. references inside installed files)
# ---------------------------------------------------------------------------
rewrite_pairs() {
    local p root
    for p in /Applications /Library /usr/local /usr /etc /private /var /opt /bin /sbin; do
        root="$(map_path "$p" 2>/dev/null)"
        [ -n "$root" ] || continue      # e.g. --home / with /private -> ""
        [ "$root" = "$p" ] && continue
        printf '%s\034%s\n' "$p" "$root"
    done
}

rewrite_installed() {  # rewrite stale refs in ONLY the package's own installed files
    [ "${#INSTALLED_FILES[@]}" -gt 0 ] || return 0
    command -v perl >/dev/null 2>&1 || { warn "perl not found; skipping path rewrite"; return 0; }
    local pairs_file pat_file line count=0 dst typ ft bin
    pairs_file=$(mktemp); pat_file=$(mktemp)
    rewrite_pairs > "$pairs_file"
    if [ ! -s "$pairs_file" ]; then rm -f "$pairs_file" "$pat_file"; return 0; fi
    while IFS= read -r line; do
        [ -z "$line" ] && continue
        printf '%s\n' "${line%%$'\034'*}" >> "$pat_file"
    done < "$pairs_file"

    for line in ${INSTALLED_FILES[@]+"${INSTALLED_FILES[@]}"}; do
        dst="${line%%$'\t'*}"
        typ="${line#*$'\t'}"; typ="${typ%%$'\t'*}"
        # dirs and symlinks: nothing to rewrite (perl -pi would follow a link
        # and edit its TARGET, which may be outside the package)
        [ "$typ" = "dir" ] && continue
        [ -L "$dst" ] && continue
        [ -f "$dst" ] || continue
        # fast path: skip files that don't reference any stale prefix
        grep -qIFf "$pat_file" "$dst" 2>/dev/null || continue
        ft="$(file -b "$dst" 2>/dev/null)"
        case "$ft" in
            *plist*|*property*list*)
                bin=0
                case "$ft" in *binary*) bin=1 ;; esac
                plutil -convert xml1 "$dst" 2>/dev/null || continue
                rewrite_one "$dst" "$pairs_file" && count=$((count + 1))
                [ "$bin" -eq 1 ] && plutil -convert binary1 "$dst" 2>/dev/null || true
                ;;
            *)
                rewrite_one "$dst" "$pairs_file" && count=$((count + 1))
                ;;
        esac
    done

    [ "$count" -gt 0 ] && say "  rewrote path references in $count file(s)"
    rm -f "$pairs_file" "$pat_file"
}

rewrite_one() {  # $1 = file; $2 = pairs file (OLD\034NEW per line)
    # Single pass over each path reference token: at every path-root position
    # the LONGEST stale prefix wins (so /usr/local beats /usr, /private beats
    # /var), and the whole remaining token is consumed as a verbatim tail so a
    # shorter prefix inside a tail (e.g. /bin inside /usr/local/bin, /var
    # inside /private/var) is never re-matched. Idempotent: the NEW roots never
    # start a path token again (always preceded by a word char or /Users/...).
    PAIRS_FILE="$2" perl -pi -e '
        BEGIN {
            open(my $fh, "<", $ENV{PAIRS_FILE}) or die "pairs file: $!";
            my %m;
            while (<$fh>) { chomp; my ($o, $n) = split(/\034/, $_, 2); $m{$o} = $n; }
            close $fh;
            our %M = %m;
            our $ALT = join "|", map { quotemeta } sort { length($b) <=> length($a) } keys %M;
        }
        s{(?<![\w])($ALT)(?=/|$|[^\w/])([^\s\"\x27(),;\[\]=:]*)}{ $M{$1} . $2 }ge;
    ' "$1"
}

# ---------------------------------------------------------------------------
# script sanitization for rootless --run-scripts execution
# ---------------------------------------------------------------------------
# sanitize_script <src> <dst> — copy a script from src to dst, rewriting
# it for safe rootless execution: strip sudo, comment out commands that
# require elevation (launchctl, installer, /System/ writes, chown root).
# Binary scripts are copied untouched.
sanitize_script() {
    local src="$1" dst="$2"
    case "$(file -b "$src" 2>/dev/null)" in
        *binary*) cp "$src" "$dst"; return 0 ;;
    esac
    cp "$src" "$dst"
    # strip 'sudo' prefix (handles sudo, sudo -u user, sudo -u user -s, etc.)
    # but preserve 'sudo' inside strings/comments by only matching at line start
    perl -i -pe '
        # strip leading sudo with optional flags/args
        s/^[ \t]*sudo(?:\s+-(?:-[ \w-]+|[iuUeIkKp]))*(?:\s+\S+)?\s*//;
        # also handle sudo -u "user" -s style
        s/^[ \t]*sudo\b.*// if /^[ \t]*sudo\b/;
    ' "$dst" 2>/dev/null || true
    # comment out lines that require elevation and cannot run as current user
    perl -i -pe '
        # launchctl load/unload/install — needs root or specific perms
        s{^([ \t]*)(launchctl\b.+)}{$1# [rootless-sanitized] $2};
        # installer command — needs root
        s{^([ \t]*)(installer\b.+)}{$1# [rootless-sanitized] $2};
        # chown root — needs root
        s{^([ \t]*)(chown\s+(?:-[rhL]+\s+)*root\b.+)}{$1# [rootless-sanitized] $2};
        # writes to /System — blocked by SIP even as root
        s{^([ \t]*)((?:cp|mv|rm|mkdir|chmod)\b.*/System/.+)}{$1# [rootless-sanitized — SIP] $2};
        # DiskUtility / diskutil eraseVolume — needs root
        s{^([ \t]*)(diskutil\s+eraseVolume.+)}{$1# [rootless-sanitized] $2};
    ' "$dst" 2>/dev/null || true
}

# run_install_scripts <component dir> <mapped home root> — run the
# pre/post-install scripts of a component with sanitized paths and a
# home-rooted environment. Scripts run as the current user with
# sanitized sudo/launchctl/installer commands. Path references are
# rewritten to match the home-mapped locations.
run_install_scripts() {
    local c="$1" home_root="$2"
    [ -d "$c/Scripts" ] || return 0
    local rstage
    rstage=$(mktemp -d "${TMPDIR:-/tmp}/repkger-runscripts.XXXXXX")
    trap 'rm -rf "${rstage:-}"' RETURN
    local pairs_file
    pairs_file=$(mktemp)
    script_rewrite_pairs > "$pairs_file"
    local f name
    for f in "$c"/Scripts/*; do
        [ -f "$f" ] || continue
        name=$(basename "$f")
        case "$name" in preinstall|postinstall) ;; *) continue ;; esac
        local dst="$rstage/$name"
        sanitize_script "$f" "$dst"
        # rewrite path references in the sanitized script to match
        # the home-mapped locations (so mkdir -p /Applications/... becomes
        # mkdir -p ~/Applications/...)
        [ -s "$pairs_file" ] && rewrite_one "$dst" "$pairs_file"
        chmod +x "$dst"
        say "  running $name (sanitized for rootless)..."
        # set up a home-rooted environment like the real installer provides
        # $1 = path to this script, $2 = path to package, $3 = install location
        # $4 = root of selected install disk, $5 = / on startup disk
        DSTROOT="$home_root" \
            INSTALLER_TEMP="$rstage" \
            HOME="$home_root" \
            bash "$dst" \
                "$dst" \
                "$(dirname "$c")" \
                "$home_root" \
                "/" \
                "/" \
                2>&1 | sed 's/^/    /' || \
            warn "$name exited with non-zero status (continuing)"
    done
    rm -f "$pairs_file"
    return 0
}

# ---------------------------------------------------------------------------
# code signature / quarantine handling
# ---------------------------------------------------------------------------
# strip com.apple.quarantine from one path ($1); $2 = "r" for recursive.
# -d removes just the quarantine attr; if that fails while the attr is present
# (stuck/locked), fall back to clearing ALL attrs (-c / -cr). Best-effort.
strip_quarantine() {
    local p="$1" rec="${2:-}" label="${3:-}" flag="" cflag="-c"
    [ -n "$rec" ] && { flag="-r"; cflag="-cr"; }
    if xattr ${flag:+"$flag"} -d com.apple.quarantine "$p" >/dev/null 2>&1; then
        say "  de-quarantined: ${p#$HOME_ROOT/}${label:+ ($label)}"
        return 0
    fi
    # either the attr is absent (fine) or it won't come off — check, then hammer
    if xattr ${flag:+"$flag"} "$p" 2>/dev/null | grep -q '^com.apple.quarantine$'; then
        if xattr "$cflag" "$p" >/dev/null 2>&1; then
            say "  cleared all xattrs: ${p#$HOME_ROOT/}${label:+ ($label)}"
            return 0
        fi
        warn "could not strip quarantine on ${p#$HOME_ROOT/}${label:+ ($label)} (may be TCC/locked)"
        return 1
    fi
    return 0
}

# dequarantine $@ paths AND each one's PARENT dir. A parent dir that carries
# com.apple.quarantine re-infects anything copied into it afterwards (macOS
# quarantine inheritance), so e.g. installing into ~/Applications requires the
# attr gone from ~/Applications itself. Parents are stripped non-recursively
# (never scan $HOME or /); targets are stripped recursively.
dequarantine() {
    command -v xattr >/dev/null 2>&1 || return 0
    local p parent
    for p in "$@"; do
        [ -e "$p" ] || continue
        [ "$p" = "/" ] && continue                       # never walk /
        if [ "$p" = "$HOME_ROOT" ]; then                 # home root: attr only
            strip_quarantine "$p" "" "home root"
        else
            strip_quarantine "$p" r
        fi
        parent=$(dirname "$p")
        [ "$parent" = "$p" ] && continue                 # "/"
        strip_quarantine "$parent" "" "parent"           # own attr only, never recursive
    done
}

tcc_protected() {  # $1 = path; 0 = has com.apple.macl
    [ -e "$1" ] || return 1
    xattr -r "$1" 2>/dev/null | grep -q "com.apple.macl"
}

clear_tcc() {  # $1 = path; exit 1 with guidance if still protected
    [ -e "$1" ] || return 0
    xattr -dr com.apple.macl "$1" 2>/dev/null || true
    if tcc_protected "$1"; then
        echo "ERROR: TCC write-protection found on a previously-launched app bundle:" >&2
        echo "       $1" >&2
        echo "       macOS adds com.apple.macl to an app bundle after it is launched once," >&2
        echo "       making it read-only even for the owner. Clear it once with:" >&2
        echo "         sudo xattr -rd com.apple.macl \"$1\"" >&2
        echo "       and re-run." >&2
        return 1
    fi
    return 0
}

resign_installed() {  # verify/re-sign ONLY the package's own .app bundles
    command -v codesign >/dev/null 2>&1 || { warn "codesign not found; skipping signature checks"; return 0; }
    local line dst typ b ok=0 resigned=0
    local -a bundles=() seen=()
    # .app dirs from the package's own BOM-driven list
    for line in ${INSTALLED_FILES[@]+"${INSTALLED_FILES[@]}"}; do
        dst="${line%%$'\t'*}"
        typ="${line#*$'\t'}"; typ="${typ%%$'\t'*}"
        [ "$typ" = "dir" ] || continue
        case "$dst" in *.app) bundles+=("$dst") ;; esac
    done
    if [ "${#bundles[@]}" -eq 0 ]; then
        # no BOM / no dir entries — fall back to scanning the merged dirs
        local d
        for d in ${MERGED_DIRS[@]+"${MERGED_DIRS[@]}"}; do
            [ -d "$d" ] || continue
            while IFS= read -r b; do
                [ -z "$b" ] || bundles+=("$b")
            done < <(find "$d" -name "*.app" -type d 2>/dev/null)
        done
    fi
    [ "${#bundles[@]}" -eq 0 ] && { say "  no .app bundles found in this package"; return 0; }
    local i
    for b in ${bundles[@]+"${bundles[@]}"}; do
        for i in ${seen[@]+"${seen[@]}"}; do [ "$i" = "$b" ] && continue 2; done
        seen+=("$b")
        if codesign --verify --deep --strict "$b" >/dev/null 2>&1; then
            ok=$((ok + 1))
        elif codesign --force --deep --sign - "$b" >/dev/null 2>&1; then
            say "  ad-hoc re-signed (deep): ${b#$HOME_ROOT/}"
            resigned=$((resigned + 1))
        else
            warn "could not re-sign: ${b#$HOME_ROOT/}"
        fi
    done
    say "  .app bundles: $ok valid, $resigned ad-hoc re-signed"
}

# ---------------------------------------------------------------------------
# records
# ---------------------------------------------------------------------------
record_dir_for() {  # $1 = pkg name; $2 = version; $3 = sha8 -> echoes dir path
    local name="$1" ver="$2" sha8="$3"
    name=$(printf '%s' "$name" | tr ' /:' '_')
    echo "$RECORDS_DIR/${name}-${ver}-${sha8}"
}

write_record_header() {  # $1 = record file; $2 = pkg path; $3 = pkg sha; $4 = name; $5 = version
    {
        printf '#repkger-record v1\n'
        printf 'pkg\t%s\n' "$2"
        printf 'pkg_sha256\t%s\n' "$3"
        printf 'name\t%s\n' "$4"
        printf 'version\t%s\n' "$5"
        printf 'installed_at\t%s\n' "$(now_iso)"
        printf 'home_root\t%s\n' "$HOME_ROOT"
        local m
        for m in ${USER_MAPS[@]+"${USER_MAPS[@]}"}; do printf 'user_map\t%s\n' "$m"; done
    } > "$1"
}

# ---------------------------------------------------------------------------
# inspect
# ---------------------------------------------------------------------------
cmd_inspect() {
    local pkg="" json=0 show_scripts=1 files_list=0 files_limit=20
    while [ $# -gt 0 ]; do
        case "$1" in
            --json) json=1; shift ;;
            --show-scripts) show_scripts=1; shift ;;
            --no-scripts) show_scripts=0; shift ;;
            --files)
                files_list=1
                if [ $# -ge 2 ] && printf '%s' "$2" | grep -qE '^[0-9]+$'; then
                    files_limit="$2"; shift
                fi
                shift ;;
            -*) die "unknown option for inspect: $1" ;;
            *) [ -z "$pkg" ] && pkg="$1" || die "unexpected argument: $1"; shift ;;
        esac
    done
    [ -n "$pkg" ] || die "usage: repkger inspect <file.pkg> [--json] [--no-scripts]"

    # resolve .dmg/.zip/.bundle/directory inputs to the actual .pkg
    resolve_pkg_input "$pkg"
    pkg="$RESOLVED_PKG"

    local size sha prod_root title
    size=$(file_size "$pkg")
    sha=$(sha256_of "$pkg")
    EXPAND_TMP=$(mktemp -d "${TMPDIR:-/tmp}/repkger-inspect.XXXXXX")
    trap 'container_cleanup; safe_rm_rf "${EXPAND_TMP:-}"' EXIT
    prod_root=$(expand_pkg "$pkg" "$EXPAND_TMP") || die "cannot expand $pkg (is it an installer package?)"

    title=""
    if [ -f "$prod_root/Distribution" ]; then
        title=$(sed -n 's/.*<title>\([^<]*\)<\/title>.*/\1/p' "$prod_root/Distribution" | head -1)
    fi

    if [ "$json" -eq 1 ]; then
        command -v python3 >/dev/null 2>&1 || die "--json requires python3"
        inspect_json "$pkg" "$size" "$sha" "$title" "$prod_root"
        return 0
    fi

    echo "== $(basename "$pkg") =="
    echo "  size:      $(du -h "$pkg" 2>/dev/null | cut -f1) ($size bytes)"
    [ -n "$sha" ] && echo "  sha256:    $sha"
    [ -n "$title" ] && echo "  title:     $title"
    echo ""

    local c n=0 id ver loc auth files kb payload s line f cname
    for c in $(component_dirs "$prod_root"); do
        n=$((n + 1))
        cname=$(comp_display_name "$c" "$prod_root" "$pkg")
        id=$(comp_id "$c"); ver=$(comp_version "$c")
        loc=$(comp_install_loc "$c"); [ -z "$loc" ] && loc="/"
        auth=$(comp_auth "$c")
        files=$(comp_files "$c"); kb=$(comp_kbytes "$c")
        payload=$(payload_root "$c")
        echo "== Component $n: $cname =="
        echo "  identifier:      ${id:-<none>}"
        echo "  version:         ${ver:-<none>}"
        echo "  install-location:${loc}   (auth: ${auth:-unknown})"
        echo "  payload:         ${files:-?} files, ${kb:-?} KB"
        echo "  payload root:    ${payload:-<none>}"
        [ -f "$c/Bom" ] && echo "  BOM entries:     $(bom_paths "$c/Bom" | wc -l | tr -d ' ')"
        local scripts_out
        scripts_out=$(comp_scripts "$c")
        if [ -n "$scripts_out" ]; then
            echo "  scripts:"
            while IFS= read -r s; do
                printf '    %s (%s bytes)\n' "${s%%$'\t'*}" "${s##*$'\t'}"
            done <<< "$scripts_out"
        else
            echo "  scripts:         (none)"
        fi
        # show script content by default (Suspicious Package parity);
        # --show-scripts is now the default; use --no-scripts to suppress
        if [ "$show_scripts" -eq 1 ]; then
            local script_auth="${auth:-root}"
            for f in "$c"/Scripts/*; do
                [ -f "$f" ] || continue
                local sname
                sname=$(basename "$f")
                local when_text
                case "$sname" in
                    preinstall*) when_text="Before moving files into place" ;;
                    postinstall*) when_text="After moving files into place" ;;
                    *)            when_text="Unknown (likely referenced by another script)" ;;
                esac
                local ssize
                ssize=$(file_size "$f")
                local is_binary=0
                case "$(file -b "$f" 2>/dev/null)" in *binary*) is_binary=1 ;; esac
                echo "  --- $sname ---"
                printf '    Name: %s\n' "$sname"
                printf '    Kind: %s\n' "$(file -b "$f" 2>/dev/null | head -1)"
                printf '    Size: %s bytes\n' "$ssize"
                printf '    As User: %s\n' "$script_auth"
                printf '    When: %s\n' "$when_text"
                if [ "$is_binary" -eq 1 ]; then
                    printf '    (binary script — content not shown)\n'
                else
                    # highlight sudo/chown-root/launchctl lines that need privileges
                    local lineno=0
                    while IFS= read -r line; do
                        lineno=$((lineno + 1))
                        local marker=""
                        case "$line" in
                            *sudo[[:space:]]*|*sudo\b*)   marker=" ⚠ needs sudo" ;;
                            *chown*root*)                  marker=" ⚠ needs root" ;;
                            *launchctl*)                   marker=" ⚠ needs root" ;;
                            */System/*)                     marker=" ⚠ SIP-protected" ;;
                            *installer*)                   marker=" ⚠ needs root" ;;
                        esac
                        printf '    %3d | %s%s\n' "$lineno" "$line" "$marker"
                    done < "$f" 2>/dev/null | head -80
                fi
            done
        fi
        if [ "$files_list" -eq 1 ] && [ -f "$c/Bom" ]; then
            # Suspicious Package-style listing: BOM entries with where each
            # one will actually land after re-mapping to ~/
            local n2=0 total_entries
            total_entries=$(bom_paths "$c/Bom" | wc -l | tr -d ' ')
            echo "  --- contents (BOM; destinations are home-mapped) ---"
            while IFS= read -r s; do
                [ -z "$s" ] && continue
                p="${s%%$'\t'*}"
                [ "$p" = "." ] && continue
                n2=$((n2 + 1))
                if [ "$files_limit" -gt 0 ] && [ "$n2" -gt "$files_limit" ]; then
                    echo "    ... ($total_entries total entries; use --files <n> for more)"
                    break
                fi
                mode=$(printf '%s' "$s" | cut -d$'\t' -f2)
                rel="${p#./}"
                if [ "$loc" = "/" ]; then vp="/$rel"; else vp="$loc/$rel"; fi
                dst=$(map_path "$vp")
                local tmark
                case "$mode" in
                    12*) tmark="link" ;;
                    4*)  tmark="dir " ;;
                    *)   tmark="file" ;;
                esac
                printf '    %s %s  ->  %s\n' "$tmark" "$p" "${dst#$HOME_ROOT/}"
            done < <(bom_entry_info "$c/Bom")
        fi
        echo ""
    done
    [ "$n" -eq 0 ] && die "no components found in $pkg (unsupported package layout)"
    return 0
}

inspect_json() {  # $1 pkg $2 size $3 sha $4 title $5 prod_root
    local pkg="$1" size="$2" sha="$3" title="$4" root="$5"
    python3 - "$pkg" "$size" "$sha" "$title" "$root" <<'PY'
import json, os, re, subprocess, sys
pkg, size, sha, title, root = sys.argv[1:6]
comp = []
for d in sorted(os.listdir(root)):
    c = os.path.join(root, d)
    pi = os.path.join(c, "PackageInfo")
    if not os.path.isfile(pi):
        continue
    txt = open(pi, encoding="utf-8", errors="replace").read(4000)
    m = re.search(r'<pkg-info[^>]*identifier="([^"]*)"', txt)
    ident = m.group(1) if m else ""
    m = re.search(r'<pkg-info[^>]*version="([^"]*)"', txt)
    ver = m.group(1) if m else ""
    m = re.search(r'install-location="([^"]*)"', txt)
    loc = m.group(1) if m else "/"
    m = re.search(r'<payload[^>]*numberOfFiles="([^"]*)"', txt)
    nf = m.group(1) if m else ""
    m = re.search(r'<payload[^>]*installKBytes="([^"]*)"', txt)
    kb = m.group(1) if m else ""
    bom = os.path.join(c, "Bom")
    bomcount = 0
    if os.path.isfile(bom):
        try:
            bomcount = len(subprocess.check_output(["lsbom", bom]).splitlines())
        except Exception:
            bomcount = 0
    scripts = []
    sd = os.path.join(c, "Scripts")
    if os.path.isdir(sd):
        for f in sorted(os.listdir(sd)):
            fp = os.path.join(sd, f)
            if os.path.isfile(fp):
                scripts.append({"name": f, "size": os.path.getsize(fp)})
    comp.append({"name": os.path.basename(c), "identifier": ident, "version": ver,
                 "install_location": loc, "payload_files": nf, "payload_kb": kb,
                 "bom_entries": bomcount, "scripts": scripts})
out = {"pkg": os.path.basename(pkg), "size": int(size), "sha256": sha, "title": title, "components": comp}
print(json.dumps(out, indent=2))
PY
}

# ---------------------------------------------------------------------------
# install
# ---------------------------------------------------------------------------
cmd_install() {
    local pkg=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --home)        [ $# -ge 2 ] || die "--home needs a value"; HOME_ROOT="$2"; shift 2 ;;
            --home-rooted) KEEP_WRITABLE=0; shift ;;
            --no-keep-writable) KEEP_WRITABLE=0; shift ;;
            --keep-writable) KEEP_WRITABLE=1; shift ;;
            --map)         [ $# -ge 2 ] || die "--map needs SRC=DEST"; USER_MAPS+=("$2"); shift 2 ;;
            --only)        [ $# -ge 2 ] || die "--only needs a prefix"; ONLY_MATCHES+=("$2"); shift 2 ;;
            --list-only)   LIST_ONLY=1; DRY=1; shift ;;
            --no-sign)     DO_SIGN=0; shift ;;
            --run-scripts) RUN_SCRIPTS=1; shift ;;
            --clean)       CLEAN=1; shift ;;
            --yes)         ASSUME_YES=1; shift ;;
            --quiet)       QUIET=1; VERBOSE=0; shift ;;
            -h|--help)     usage 0 ;;
            -*)            die "unknown option for install: $1" ;;
            *)             [ -z "$pkg" ] && pkg="$1" || die "unexpected argument: $1"; shift ;;
        esac
    done
    [ -n "$pkg" ] || die "usage: repkger install <file.pkg> [options]"
    HOME_ROOT="${HOME_ROOT%/}"
    [ -n "$HOME_ROOT" ] || HOME_ROOT="/"
    if [ "$HOME_ROOT" != "/" ] && [ "$DRY" -eq 0 ]; then
        mkdir -p "$HOME_ROOT"
    fi

    # resolve .dmg/.zip/.bundle/directory inputs to the actual .pkg
    resolve_pkg_input "$pkg"
    pkg="$RESOLVED_PKG"

    require_cmds ditto
    local sha size name ver
    sha=$(sha256_of "$pkg")
    size=$(file_size "$pkg")
    [ -n "$sha" ] || warn "could not compute sha256 of $pkg"

    name=$(basename "$pkg"); name="${name%.*}"
    ver="unknown"

    EXPAND_TMP=$(mktemp -d "${TMPDIR:-/tmp}/repkger.XXXXXX")
    trap 'container_cleanup; safe_rm_rf "${EXPAND_TMP:-}"' EXIT

    say "== Expanding $pkg =="
    local prod_root
    prod_root=$(expand_pkg "$pkg" "$EXPAND_TMP") || die "cannot expand $pkg"

    local -a comps=()
    local c
    while IFS= read -r c; do comps+=("$c"); done < <(component_dirs "$prod_root")
    [ "${#comps[@]}" -gt 0 ] || die "no components found in $pkg"

    local v
    v=$(comp_version "${comps[0]}")
    # Unity stamps PackageInfo version="0" and keeps the real version in the
    # Distribution — prefer a meaningful version from there
    case "$v" in ""|0|"<none>") v=$(dist_version "$prod_root/Distribution") ;; esac
    [ -n "$v" ] && ver="$v"
    if [ "${#comps[@]}" -eq 1 ]; then
        local id; id=$(comp_id "${comps[0]}")
        [ -n "$id" ] && name="$id"
    fi

    local sha8 rec
    sha8=${sha:0:8}
    rec=$(record_dir_for "$name" "$ver" "$sha8")

    echo ""
    say "== $(basename "$pkg")  (${#comps[@]} component(s), install root: $HOME_ROOT) =="

    local loc payload mapped_loc
    for c in ${comps[@]+"${comps[@]}"}; do
        loc=$(comp_install_loc "$c"); [ -z "$loc" ] && loc="/"
        set_only_matches "$loc"
        payload=$(payload_root "$c")
        [ -n "$payload" ] || { warn "SKIP $(basename "$c"): no payload"; continue; }
        say "== $(comp_display_name "$c" "$prod_root" "$pkg")  install-location: $loc =="

        # TCC guard: a previously-launched app bundle under the target dir is
        # write-protected (com.apple.macl) even for its owner — clear it or abort.
        mapped_loc=$(map_path "$loc")
        # install-location "/" maps to "/" itself — never xattr-walk the whole
        # filesystem; merge_tree handles its children individually.
        if [ "$DRY" -eq 0 ] && [ -n "$mapped_loc" ] && [ "$mapped_loc" != "/" ] \
           && [ "$mapped_loc" != "$HOME_ROOT" ] && [ -e "$mapped_loc" ] \
           && tcc_protected "$mapped_loc"; then
            clear_tcc "$mapped_loc" || exit 1
        fi

        if [ -d "$payload" ]; then
            merge_tree "$payload" "$loc"
        elif [ -f "$payload" ]; then
            local stage
            stage="$(dirname "$EXPAND_TMP")/stage-$(basename "$c")"
            if ! extract_payload_file "$payload" "$stage"; then
                die "cannot extract payload of $(basename "$c") (gzip/cpio and pbzx failed)"
            fi
            [ "$DRY" -eq 0 ] && merge_tree "$stage" "$loc"
            [ "$DRY" -eq 1 ] && say "  would extract + merge payload of $(basename "$c")"
        fi
        # the mapped install-location dir (parent of the merged content) is
        # where quarantine inheritance matters — remember it for stripping.
        # install-location "/" maps to "/" itself (useless) — merge_tree
        # already handles its children individually.
        [ "$DRY" -eq 0 ] && [ "$loc" != "/" ] && mapped_loc_add "$mapped_loc"
    done

    if [ "$DRY" -eq 1 ]; then
        echo ""
        echo "=== LIST ONLY (nothing installed) ==="
        return 0
    fi

    # the package's own landed files (BOM-driven) — used by rewrite, resign AND
    # the record, so none of those ever scan outside the package
    build_installed_files ${comps[@]+"${comps[@]}"}

    # ---------------- post-merge passes (package's own files only) ----------------
    if [ "$DO_SIGN" -eq 1 ] && { [ "${#MERGED_DIRS[@]}" -gt 0 ] || [ "${#MAPPED_LOCS[@]}" -gt 0 ]; }; then
        echo "== De-quarantining installed files (targets + parents) =="
        dequarantine ${MERGED_DIRS[@]+"${MERGED_DIRS[@]}"} ${MAPPED_LOCS[@]+"${MAPPED_LOCS[@]}"}
    fi
    echo "== Rewriting stale installer path references =="
    rewrite_installed
    if [ "$DO_SIGN" -eq 1 ]; then
        echo "== Checking code signatures =="
        resign_installed
    fi
    # record code-signature artifacts the resign pass created (they are not in
    # the BOM, so the BOM-driven walk can't see them) — uninstall must reverse
    # everything
    if [ "$DO_SIGN" -eq 1 ]; then
        local line2 dst2 typ2 f2
        for line2 in ${INSTALLED_FILES[@]+"${INSTALLED_FILES[@]}"}; do
            dst2="${line2%%$'\t'*}"
            typ2="${line2#*$'\t'}"; typ2="${typ2%%$'\t'*}"
            [ "$typ2" = "dir" ] || continue
            case "$dst2" in
                *.app)
                    [ -d "$dst2/Contents/_CodeSignature" ] || continue
                    INSTALLED_FILES+=("$dst2/Contents/_CodeSignature"$'\t'"dir"$'\t\t\t')
                    while IFS= read -r -d '' f2; do
                        INSTALLED_FILES+=("$f2"$'\t'"file"$'\t\t\t')
                    done < <(find "$dst2/Contents/_CodeSignature" -mindepth 1 -print0)
                    ;;
            esac
        done
    fi

    # ---------------- run scripts (if --run-scripts) ----------------
    if [ "$RUN_SCRIPTS" -eq 1 ]; then
        echo "== Running install scripts (sanitized for rootless) =="
        for c in ${comps[@]+"${comps[@]}"}; do
            run_install_scripts "$c" "$HOME_ROOT"
        done
    fi

    # ---------------- record ----------------
    mkdir -p "$rec"
    local recfile="$rec/record.tsv"
    write_record_header "$recfile" "$pkg" "$sha" "$name" "$ver"
    local id2 v2 loc2 s
    {
        printf '# section: components\n'
        for c in ${comps[@]+"${comps[@]}"}; do
            id2=$(comp_id "$c"); v2=$(comp_version "$c"); loc2=$(comp_install_loc "$c")
            printf 'component\t%s\t%s\t%s\n' "${id2:-<none>}" "${v2:-<none>}" "${loc2:-/}"
            while IFS= read -r s; do
                local sname
                sname="${s%%$'\t'*}"
                local ssum=""
                command -v md5 >/dev/null 2>&1 && ssum=$(md5 -q "$c/Scripts/$sname" 2>/dev/null || echo "")
                printf 'script\t%s\t%s\t%s\n' "${id2:-<none>}" "$sname" "$ssum"
            done < <(comp_scripts "$c")
        done
        printf '# section: files\n'
        local fline
        for fline in ${INSTALLED_FILES[@]+"${INSTALLED_FILES[@]}"}; do
            printf 'file\t%s\n' "$fline"
        done
    } >> "$recfile"

    local total
    total=$(grep -c $'^file\t' "$recfile" || true)
    echo ""
    echo "=== DONE ==="
    say "Installed $(basename "$pkg") into mapped locations (root: $HOME_ROOT)."
    say "Files recorded: $total"
    say "Record: $rec"
    if [ "$RUN_SCRIPTS" -eq 1 ]; then
        say "Pre/post-install scripts were RUN with a home-rooted environment."
    else
        say "Postinstall scripts were NOT run (use --run-scripts to opt in)."
    fi
    local s2
    while IFS= read -r s2; do
        [ -z "$s2" ] && continue
        say "  script recorded: $s2"
    done < <(grep $'^script\t' "$recfile" 2>/dev/null | cut -f3-4 | sort -u | awk '{print $1" ("$2")"}')
}

# ---------------------------------------------------------------------------
# bom-redo — redo the package BOM to the mapped no-sudo locations and repack
# ---------------------------------------------------------------------------
# bom_redo_leaves <payload dir> <virtual abs path> — walks the payload tree
# with the SAME boundary logic as merge_tree and echoes one line per mapping
# boundary leaf: "<abs src dir><TAB><mapped dest root>". Each leaf is exactly
# the subtree that lands under a single mapped root, so pkgbuild --root <leaf>
# --install-location <mapped> reproduces the payload at the no-sudo location.
bom_redo_leaves() {
    local src="$1" vpath="$2"
    shopt -s dotglob nullglob
    local c rel vc has_boundary=0 b
    for c in "$src"/*; do
        [ -e "$c" ] || continue
        rel="${c##*/}"
        vc="${vpath%/}/$rel"
        has_boundary=0
        # boundary below vc iff some mapping prefix is a descendant of vc
        while IFS= read -r b; do
            [ -z "$b" ] && continue
            case "$b" in
                "$vc/"*) has_boundary=1; break ;;
            esac
        done < <(map_prefixes)
        # targeted extraction (--only): descend when a requested prefix lies
        # deeper, otherwise emit only subtrees at/under a prefix
        if [ "$has_boundary" -eq 1 ] || { [ "${#ONLY_MATCHES[@]}" -gt 0 ] && only_below "$vc"; }; then
            bom_redo_leaves "$c" "$vc"
        else
            [ "${#ONLY_MATCHES[@]}" -gt 0 ] && ! only_match "$vc" && continue
            printf '%s\t%s\t%s\n' "$c" "$(map_path "$vc")" "$vc"
        fi
    done
    shopt -u dotglob nullglob
}

# ---------------------------------------------------------------------------
# script adjustment for redone packages — pre/post-install "equivalents"
# ---------------------------------------------------------------------------
# Pairs used to adjust install scripts embedded in a redone package. Same
# home-mapping as the payload rewrite, EXCEPT the pure system-tool dirs
# (/usr, /bin, /sbin): a postinstall still needs `#!/bin/sh` and
# /usr/bin/env to resolve to the REAL system tools — those exist regardless
# of where the payload lands, and their home-mapped equivalents don't. User
# --map pairs always win and are always applied.
script_rewrite_pairs() {
    local p root
    for p in /Applications /Library /usr/local /etc /private /var /opt /Users/Shared /tmp; do
        root=$(map_path "$p" 2>/dev/null)
        [ -n "$root" ] || continue
        [ "$root" = "$p" ] && continue
        printf '%s\034%s\n' "$p" "$root"
    done
    local entry src dst
    for entry in ${USER_MAPS[@]+"${USER_MAPS[@]}"}; do
        src="${entry%%=*}"; dst="${entry#*=}"
        [ "$src" = "$dst" ] && continue
        printf '%s\034%s\n' "$src" "$dst"
    done
}

# redo_scripts <comp dir> <stage dir> — copy the component's install scripts
# into <stage> with every path reference home-mapped to match the redone BOM
# (binary scripts are copied untouched; the shebang survives because the
# system-tool dirs aren't in script_rewrite_pairs). Echoes
# "name<TAB>changed-line-count" per adjusted script.
redo_scripts() {
    local c="$1" stage="$2"
    [ -d "$c/Scripts" ] || return 0
    local pairs_file f name changed bin
    pairs_file=$(mktemp)
    script_rewrite_pairs > "$pairs_file"
    rm -rf "$stage"; mkdir -p "$stage"
    cp -p "$c"/Scripts/* "$stage"/ 2>/dev/null || true
    [ -s "$pairs_file" ] || { rm -f "$pairs_file"; return 0; }
    local origdir; origdir="$(dirname "$stage")/orig-scripts-$(basename "$stage")"
    rm -rf "$origdir"; mkdir -p "$origdir"
    for f in "$stage"/*; do
        [ -f "$f" ] || continue
        name=$(basename "$f")
        case "$(file -b "$f" 2>/dev/null)" in *binary*) continue ;; esac
        cp "$c/Scripts/$name" "$origdir/$name"
        rewrite_one "$f" "$pairs_file"
        changed=$(diff "$origdir/$name" "$f" 2>/dev/null | grep -c '^>' || true)
        [ "$changed" -gt 0 ] && printf '%s\t%s\n' "$name" "$changed"
    done
    rm -f "$pairs_file"; rm -rf "$origdir"
    return 0
}

# script_estimate <comp dir> — Suspicious-Package-style estimate of what the
# embedded install scripts become: how many refs get home-mapped, and which
# lines still need privileges (those CANNOT be mapped). Prints only.
script_estimate() {
    local c="$1"
    [ -d "$c/Scripts" ] || return 0
    local pairs_file f name old changed unmappable line pats=""
    pairs_file=$(mktemp)
    script_rewrite_pairs > "$pairs_file"
    if [ ! -s "$pairs_file" ]; then
        rm -f "$pairs_file"
        echo "  scripts: no path adjustments needed"
        return 0
    fi
    while IFS= read -r line; do
        [ -z "$line" ] && continue
        old="${line%%$'\034'*}"
        pats="${pats:+$pats|}$(printf '%s' "$old" | sed 's/[][\/.^$*+?(){}|]/\\&/g')"
    done < "$pairs_file"
    rm -f "$pairs_file"
    for f in "$c"/Scripts/*; do
        [ -f "$f" ] || continue
        name=$(basename "$f")
        changed=$(grep -Ec "$pats" "$f" 2>/dev/null || true)
        unmappable=$(grep -cE -e 'sudo[[:space:]]' -e 'chown[[:space:]]+[^[:space:]]*root' \
            -e 'launchctl[[:space:]]' -e '/System/' -e '[[:space:]]installer[[:space:]]' "$f" 2>/dev/null || true)
        printf '    %s: %s ref(s) -> home-mapped' "$name" "$changed"
        if [ "$unmappable" -gt 0 ]; then
            printf '; %s line(s) need privileges and CANNOT be mapped (sudo/chown-root/launchctl/installer/System)\n' "$unmappable"
        else
            printf '\n'
        fi
    done
    return 0
}

# predictive BOM — Suspicious-Package-style preview of the redone package:
# every mapping-boundary leaf -> mapped root, a sample of the predicted BOM
# entries, and the script estimates. Builds nothing, writes nothing.
cmd_bom_redo_preview() {  # $1 name; $2 ver; $3 prod_root; $4 pkg; $5... comp dirs
    local name="$1" ver="$2" prod_root="$3" pkg="$4"; shift 4
    local -a comps=()
    local c
    for c in "$@"; do comps+=("$c"); done
    echo "== Predictive BOM: $(basename "$pkg") (v${ver:-?}) — nothing written, no pkgbuild =="
    local comp_i=0 loc payload leaf leafsrc mapped vc rest idx cnt f rel shown
    local total_leaves=0 total_entries=0
    for c in ${comps[@]+"${comps[@]}"}; do
        comp_i=$((comp_i + 1))
        loc=$(comp_install_loc "$c"); [ -z "$loc" ] && loc="/"
        payload=$(payload_root "$c")
        [ -n "$payload" ] || { warn "SKIP $(basename "$c"): no payload"; continue; }
        if [ ! -d "$payload" ]; then
            warn "SKIP $(basename "$c"): payload is compressed, not a dir (re-run with --clean)"
            continue
        fi
        set_only_matches "$loc"
        echo ""
        echo "== Component $comp_i: $(comp_display_name "$c" "$prod_root" "$pkg")  (install-location: $loc) =="
        idx=0
        while IFS= read -r leaf; do
            [ -z "$leaf" ] && continue
            leafsrc="${leaf%%$'\t'*}"; rest="${leaf#*$'\t'}"
            mapped="${rest%%$'\t'*}"; vc="${rest#*$'\t'}"
            [ -n "$mapped" ] || continue
            [ "$mapped" = "/" ] && continue
            idx=$((idx + 1)); total_leaves=$((total_leaves + 1))
            cnt=$(find "$leafsrc" -mindepth 1 2>/dev/null | wc -l | tr -d ' ')
            total_entries=$((total_entries + cnt))
            echo "  leaf $idx: $vc  ->  $mapped   ($cnt predicted entries)"
            shown=0
            while IFS= read -r -d '' f; do
                rel="${f#"$leafsrc"/}"
                printf '      ./%s  ->  %s/%s\n' "$rel" "${mapped%/}" "$rel"
                shown=$((shown + 1))
                [ "$shown" -ge 5 ] && { echo "      ..."; break; }
            done < <(find "$leafsrc" -mindepth 1 -print0 2>/dev/null)
        done < <(bom_redo_leaves "$payload" "$loc")
        script_estimate "$c"
    done
    echo ""
    echo "Total: $total_leaves leaf package(s), $total_entries predicted BOM entries."
    if [ "${#ONLY_MATCHES[@]}" -gt 0 ]; then
        echo "Targeted: only paths at/under: ${ONLY_MATCHES[*]}"
    fi
    return 0
}

cmd_bom_redo() {
    local pkg="" out="$REPKGER_DATA/rootless"
    while [ $# -gt 0 ]; do
        case "$1" in
            --home)        [ $# -ge 2 ] || die "--home needs a value"; HOME_ROOT="$2"; shift 2 ;;
            --out)         [ $# -ge 2 ] || die "--out needs a value"; out="$2"; shift 2 ;;
            --map)         [ $# -ge 2 ] || die "--map needs SRC=DEST"; USER_MAPS+=("$2"); shift 2 ;;
            --only)        [ $# -ge 2 ] || die "--only needs a prefix"; ONLY_MATCHES+=("$2"); shift 2 ;;
            --preview)     PREVIEW=1; shift ;;
            --list-only)   PREVIEW=1; shift ;;
            --home-rooted) KEEP_WRITABLE=0; shift ;;
            --keep-writable) KEEP_WRITABLE=1; shift ;;
            --clean)       CLEAN=1; shift ;;
            --quiet)       QUIET=1; VERBOSE=0; shift ;;
            -h|--help)     usage 0 ;;
            -*)            die "unknown option for bom-redo: $1" ;;
            *)             [ -z "$pkg" ] && pkg="$1" || die "unexpected argument: $1"; shift ;;
        esac
    done
    [ -n "$pkg" ] || die "usage: repkger bom-redo <file.pkg> [--home DIR] [--out DIR] [--map SRC=DEST] [--only PREFIX] [--preview]"
    HOME_ROOT="${HOME_ROOT%/}"; [ -n "$HOME_ROOT" ] || HOME_ROOT="/"

    # resolve .dmg/.zip/.bundle/directory inputs to the actual .pkg
    resolve_pkg_input "$pkg"
    pkg="$RESOLVED_PKG"

    local sha name ver
    sha=$(sha256_of "$pkg")
    name=$(basename "$pkg"); name="${name%.*}"
    name=$(printf '%s' "$name" | tr ' /:' '_')
    ver="unknown"

    EXPAND_TMP=$(mktemp -d "${TMPDIR:-/tmp}/repkger-bomredo.XXXXXX")
    trap 'container_cleanup; safe_rm_rf "${EXPAND_TMP:-}"' EXIT

    say "== Expanding $pkg =="
    local prod_root
    prod_root=$(expand_pkg "$pkg" "$EXPAND_TMP") || die "cannot expand $pkg"

    local -a comps=()
    local c
    while IFS= read -r c; do comps+=("$c"); done < <(component_dirs "$prod_root")
    [ "${#comps[@]}" -gt 0 ] || die "no components found in $pkg"

    local v
    v=$(comp_version "${comps[0]}")
    # Unity stamps PackageInfo version="0" — prefer the Distribution version
    case "$v" in ""|0|"<none>") v=$(dist_version "$prod_root/Distribution") ;; esac
    [ -n "$v" ] && ver="$v"

    if [ "$PREVIEW" -eq 1 ]; then
        cmd_bom_redo_preview "$name" "$ver" "$prod_root" "$pkg" ${comps[@]+"${comps[@]}"}
        return 0
    fi

    require_cmds pkgbuild
    command -v mkbom >/dev/null 2>&1 || die "required tool not found: mkbom"

    mkdir -p "$out"
    say "== Redoing BOM of $(basename "$pkg") to no-sudo locations (root: $HOME_ROOT) =="

    local -a built=()
    local comp_i=0 idx=0 leaf leafsrc mapped
    local cid cver loc payload pkgout outname slug scr_stage scr_out sline vc rest
    for c in ${comps[@]+"${comps[@]}"}; do
        comp_i=$((comp_i + 1))
        loc=$(comp_install_loc "$c"); [ -z "$loc" ] && loc="/"
        set_only_matches "$loc"
        payload=$(payload_root "$c")
        [ -n "$payload" ] || { warn "SKIP $(basename "$c"): no payload"; continue; }
        if [ ! -d "$payload" ]; then
            die "payload of $(basename "$c") is a compressed file, not a dir (needs pkgutil --expand-full; try --clean)"
        fi
        cid=$(comp_id "$c"); cver=$(comp_version "$c")
        case "$cver" in ""|0|"<none>") cver="$v" ;; esac
        [ -z "$cver" ] && cver="1.0"
        say "== $(comp_display_name "$c" "$prod_root" "$pkg")  install-location: $loc =="

        # stage adjusted install scripts once per component: copies with every
        # path reference home-mapped to match the redone BOM (estimates of the
        # original pre/post-install logic; system-tool dirs left untouched)
        scr_stage=""
        if [ -d "$c/Scripts" ]; then
            scr_stage="$EXPAND_TMP/scripts-$comp_i"
            scr_out=$(redo_scripts "$c" "$scr_stage")
            if [ -n "$scr_out" ]; then
                while IFS= read -r sline; do
                    [ -z "$sline" ] && continue
                    say "  adjusted script $(printf '%s' "$sline" | cut -f1): $(printf '%s' "$sline" | cut -f2) path ref(s) home-mapped to match the new BOM"
                done <<< "$scr_out"
            fi
        fi

        idx=0
        while IFS= read -r leaf; do
            [ -z "$leaf" ] && continue
            idx=$((idx + 1))
            leafsrc="${leaf%%$'\t'*}"; rest="${leaf#*$'\t'}"
            mapped="${rest%%$'\t'*}"; vc="${rest#*$'\t'}"
            [ -n "$mapped" ] || continue
            [ "$mapped" = "/" ] && { warn "SKIP $vc: maps to / (cannot root a repack at /)"; continue; }
            slug=$(printf '%s' "$mapped" | tr '/' '_' | tr -c 'A-Za-z0-9_.-' '_')
            pkgout="$out/${name}-${comp_i}-${idx}-${slug}.pkg"
            rm -f "$pkgout"
            say "  leaf: $vc  ->  $mapped"
            local -a pb=()
            pb+=(--root "$leafsrc" --install-location "$mapped")
            pb+=(--identifier "$cid")   # same id: rootless leaves of one component merge records
            pb+=(--version "$cver" --ownership preserve)
            [ -n "$scr_stage" ] && pb+=(--scripts "$scr_stage")
            if ! pkgbuild "${pb[@]}" "$pkgout" >/dev/null 2>&1; then
                # scripts may trip pkgbuild (e.g. arch-suffixed names) — retry without
                if [ -d "$c/Scripts" ] && pkgbuild --root "$leafsrc" --install-location "$mapped" \
                    --identifier "$cid" --version "$cver" --ownership preserve "$pkgout" >/dev/null 2>&1; then
                    say "    (built without scripts)"
                else
                    die "pkgbuild failed for $(basename "$leafsrc") (-> $mapped)"
                fi
            fi
            built+=("$pkgout")
        done < <(bom_redo_leaves "$payload" "$loc")
    done

    [ "${#built[@]}" -gt 0 ] || die "nothing to redo (no mappable payload content)"

    # assemble: single pkg -> <out>/<name>-rootless.pkg ; else .mpkg bundle
    local final=""
    if [ "${#built[@]}" -eq 1 ]; then
        final="$out/${name}-rootless.pkg"
        rm -f "$final"
        mv "${built[0]}" "$final"
    else
        final="$out/${name}-rootless.mpkg"
        rm -rf "$final"
        mkdir -p "$final/Contents/Packages"
        local i=0 bp
        for bp in ${built[@]+"${built[@]}"}; do
            i=$((i + 1))
            mv "$bp" "$final/Contents/Packages/$(printf '%02d' "$i")-$(basename "$bp")"
        done
        write_distribution "$final/Contents/Distribution" "$name" "$ver" "$final/Contents/Packages"
    fi

    echo ""
    echo "=== BOM REDONE ==="
    say "Component version: $ver"
    say "Output: $final"
    say "The redone BOM lists every file at its mapped no-sudo destination:"
    show_redone_bom "$final" | head -25 || true
    echo ""
    say "Install it like any pkg: repkger install '$final' --home '$HOME_ROOT' --yes"
    say "(all destinations are under $HOME_ROOT or already writable, so nothing is re-mapped)"
}

write_distribution() {  # $1 = dist path; $2 = title; $3 = version; $4 = packages dir
    local dist="$1" title="$2" ver="$3" pdir="$4" p pkgid refs="" choices=""
    {
        echo '<?xml version="1.0" encoding="utf-8"?>'
        echo '<installer-gui-script minSpecVersion="1">'
        echo "  <title>$title (rootless)</title>"
        for p in "$pdir"/*.pkg; do
            [ -f "$p" ] || continue
            pkgid=$(pkgbuild_ident "$p")
            refs="$refs  <pkg-ref id=\"$pkgid\"><install KBytes=\"$(pkgbuild_kbytes "$p")\"/></pkg-ref>\n"
            choices="$choices  <line choice=\"ch-$pkgid\"/>\n"
        done
        echo '  <choices-outline>'
        printf '%b' "$choices" | sed 's/^/    /'
        echo '  </choices-outline>'
        for p in "$pdir"/*.pkg; do
            [ -f "$p" ] || continue
            pkgid=$(pkgbuild_ident "$p")
            echo "  <choice id=\"ch-$pkgid\" title=\"$pkgid\">"
            echo "    <pkg-ref id=\"$pkgid\"/>"
            echo '  </choice>'
        done
        printf '%b' "$refs"
        echo '</installer-gui-script>'
    } > "$dist"
}

pkgbuild_ident() {  # $1 = component pkg; echoes its identifier from PackageInfo
    local t
    t=$(mktemp -d)
    (cd "$t" && xar -xf "$1" PackageInfo >/dev/null 2>&1)
    local id
    id=$(xml_attr "$t/PackageInfo" pkg-info identifier)
    rm -rf "$t"
    echo "$id"
}

pkgbuild_kbytes() {  # $1 = component pkg; echoes install KBytes from PackageInfo
    local t
    t=$(mktemp -d)
    (cd "$t" && xar -xf "$1" PackageInfo >/dev/null 2>&1)
    local kb
    kb=$(xml_attr "$t/PackageInfo" payload installKBytes)
    rm -rf "$t"
    echo "${kb:-0}"
}

show_redone_bom() {  # $1 = rootless .pkg or .mpkg; echoes redone BOM entries
    local t p
    t=$(mktemp -d)
    trap 'rm -rf "$t"' RETURN
    if [ -d "$1" ]; then
        for p in "$1"/Contents/Packages/*.pkg; do
            [ -f "$p" ] || continue
            (cd "$t" && xar -xf "$p" Bom >/dev/null 2>&1)
            echo "-- $(basename "$p"): $(lsbom "$t/Bom" 2>/dev/null | wc -l | tr -d ' ') entries --"
            lsbom "$t/Bom" 2>/dev/null | head -12 || true
        done
    else
        (cd "$t" && xar -xf "$1" Bom >/dev/null 2>&1)
        lsbom "$t/Bom" 2>/dev/null | head -20 || true
    fi
    rm -rf "$t"
    trap - RETURN
}

# ---------------------------------------------------------------------------
# uninstall
# ---------------------------------------------------------------------------
cmd_uninstall() {
    local arg="" purge=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --yes) ASSUME_YES=1; shift ;;
            --purge) purge=1; shift ;;
            -h|--help) usage 0 ;;
            *) [ -z "$arg" ] && arg="$1" || die "unexpected argument: $1"; shift ;;
        esac
    done
    [ -n "$arg" ] || die "usage: repkger uninstall <file.pkg|name|record> [--purge]"

    local -a recs=()
    local r needle
    if [ -d "$RECORDS_DIR/$arg" ]; then
        recs+=("$RECORDS_DIR/$arg")
    else
        needle=$(basename "$arg")
        for r in "$RECORDS_DIR"/*; do
            [ -f "$r/record.tsv" ] || continue
            local rpkg rname
            rpkg=$(awk -F'\t' '$1=="pkg"{print $2; exit}' "$r/record.tsv")
            rname=$(awk -F'\t' '$1=="name"{print $2; exit}' "$r/record.tsv")
            if [ "$(basename "$rpkg")" = "$needle" ] || [ "$rname" = "$needle" ] || [ "$(basename "$r")" = "$needle" ]; then
                recs+=("$r")
            fi
        done
    fi
    [ "${#recs[@]}" -gt 0 ] || die "no repkger record found for '$arg' (records dir: $RECORDS_DIR)"

    local target i choice
    if [ "${#recs[@]}" -eq 1 ]; then
        target="${recs[0]}"
    else
        echo "Multiple records match '$arg':"
        i=1
        for r in ${recs[@]+"${recs[@]}"}; do
            printf '  %d) %s  (%s %s)\n' "$i" "$(basename "$r")" \
                "$(awk -F'\t' '$1=="name"{print $2}' "$r/record.tsv" | head -1)" \
                "$(awk -F'\t' '$1=="version"{print $2}' "$r/record.tsv" | head -1)"
            i=$((i + 1))
        done
        if [ "$ASSUME_YES" -eq 1 ]; then
            target="${recs[0]}"
        else
            printf 'Which one? [1-%d] ' "${#recs[@]}" >&2
            IFS= read -r choice || die "aborted"
            case "$choice" in
                ''|*[!0-9]*) die "invalid choice" ;;
                *) [ "$choice" -ge 1 ] && [ "$choice" -le "${#recs[@]}" ] || die "invalid choice"
                   target="${recs[$((choice - 1))]}" ;;
            esac
        fi
    fi

    local recfile name ver nfiles n=0 d removed=0 line dst typ
    recfile="$target/record.tsv"
    name=$(awk -F'\t' '$1=="name"{print $2; exit}' "$recfile")
    ver=$(awk -F'\t' '$1=="version"{print $2; exit}' "$recfile")
    local recorded_root
    recorded_root=$(awk -F'\t' '$1=="home_root"{print $2; exit}' "$recfile")
    [ -n "$recorded_root" ] && HOME_ROOT="$recorded_root"
    nfiles=$(grep -c $'^file\t' "$recfile" || true)
    echo "== Uninstalling $name $ver (record: $(basename "$target")) =="
    echo "  $nfiles recorded entries"
    confirm "Remove these files?" || die "aborted"

    local -a dirs=()
    while IFS= read -r line; do
        [ -z "$line" ] && continue
        dst=$(printf '%s' "$line" | cut -d$'\t' -f2)
        typ=$(printf '%s' "$line" | cut -d$'\t' -f3)
        [ -z "$dst" ] && continue
        if [ "$typ" = "dir" ]; then
            dirs+=("$dst")
            continue
        fi
        if [ -e "$dst" ] || [ -L "$dst" ]; then
            if ! rm -f "$dst" 2>/dev/null; then
                if tcc_protected "$dst" 2>/dev/null || tcc_protected "$(dirname "$dst")" 2>/dev/null; then
                    echo "ERROR: TCC write-protection on $dst" >&2
                    echo "       Fix once with: sudo xattr -rd com.apple.macl \"$(dirname "$dst")\"" >&2
                else
                    echo "WARN: could not remove $dst" >&2
                fi
            else
                n=$((n + 1))
            fi
        fi
    done < <(grep $'^file\t' "$recfile" | reverse_lines)

    for d in ${dirs[@]+"${dirs[@]}"}; do
        [ -d "$d" ] || continue
        rmdir "$d" 2>/dev/null && removed=$((removed + 1))
    done

    # also sweep the mapped install-location dirs (only if empty)
    local cloc cdir
    while IFS= read -r cloc; do
        [ -z "$cloc" ] && continue
        cdir=$(map_path "$cloc" 2>/dev/null)
        [ -d "$cdir" ] || continue
        rmdir "$cdir" 2>/dev/null && removed=$((removed + 1))
    done < <(awk -F'\t' '$1=="component"{print $4}' "$recfile")

    if [ "$purge" -eq 1 ]; then
        rm -rf "$target"
        say "Record purged: $target"
    else
        say "Record kept (re-run with --purge to delete it): $target"
    fi
    echo "=== Uninstalled: $n file(s) removed, $removed empty dir(s) removed ==="
}

# ---------------------------------------------------------------------------
# list
# ---------------------------------------------------------------------------
cmd_list() {
    local json=0
    [ "${1:-}" = "--json" ] && json=1
    if [ "$json" -eq 1 ]; then
        command -v python3 >/dev/null 2>&1 || die "--json requires python3"
        python3 - "$RECORDS_DIR" <<'PY'
import json, os, sys
root = sys.argv[1]
out = []
if os.path.isdir(root):
    for r in sorted(os.listdir(root)):
        rf = os.path.join(root, r, "record.tsv")
        if not os.path.isfile(rf):
            continue
        d = {}
        for line in open(rf, encoding="utf-8", errors="replace"):
            line = line.rstrip("\n")
            if not line or line.startswith("#"):
                continue
            k, _, v = line.partition("\t")
            if k == "file":
                parts = v.split("\t")
                d.setdefault("files", []).append({"dst": parts[0], "type": parts[1] if len(parts) > 1 else "file"})
            elif k not in ("component", "script", "user_map"):
                d[k] = v
        out.append(d)
print(json.dumps(out, indent=2))
PY
        return 0
    fi
    [ -d "$RECORDS_DIR" ] || { echo "(no records yet — install something with 'repkger install <file.pkg>')"; return 0; }
    printf '%-46s %-24s %-18s %-10s %s\n' "RECORD" "NAME" "VERSION" "FILES" "INSTALLED"
    local r name ver files when
    for r in "$RECORDS_DIR"/*; do
        [ -f "$r/record.tsv" ] || continue
        name=$(awk -F'\t' '$1=="name"{print $2; exit}' "$r/record.tsv")
        ver=$(awk -F'\t' '$1=="version"{print $2; exit}' "$r/record.tsv")
        when=$(awk -F'\t' '$1=="installed_at"{print $2; exit}' "$r/record.tsv")
        files=$(grep -c $'^file\t' "$r/record.tsv" || true)
        printf '%-46s %-24s %-18s %-10s %s\n' "$(basename "$r")" "$name" "$ver" "$files" "$when"
    done
}

# ---------------------------------------------------------------------------
# brew wrapper
# ---------------------------------------------------------------------------
# cleanup for the brew wrapper's dmg/zip container handling (EXIT trap):
# detach a mounted volume, drop the extract dir. No-ops when unused.
# now delegates to container_cleanup which handles both CASK_* and CONTAINER_* vars
cask_cleanup() {
    container_cleanup
}

cmd_brew() {
    [ $# -gt 0 ] || { warn "usage: repkger brew <brew args...>"; exec brew "$@" 2>/dev/null || true; }
    # --rpkg = FORCE the rootless repkger strategy for a pkg cask: never fall
    # through to real brew (which would run the cask's pkg installer with sudo).
    # --map SRC=DEST is passed through to the rootless install (e.g. Unity Hub
    # layout: --map "/Applications/Unity/Unity=$HOME/Applications/Unity/Hub/Editor/<ver>").
    local cask="" i rpkg=0 lastarg="" skipnext=0
    local -a MAP_ARGS=()
    for i in "$@"; do
        case "$i" in
            --rpkg) rpkg=1 ;;
            --map) skipnext=1; MAP_ARGS+=("$i") ;;
            --map=*) MAP_ARGS+=("$i") ;;
            --cask) cask="next" ;;
            --cask=*) cask="${i#--cask=}" ;;
            *)
                if [ "$skipnext" -eq 1 ]; then skipnext=0; MAP_ARGS+=("$i"); continue; fi
                lastarg="$i"; [ "$cask" = "next" ] && cask="$i" ;;
        esac
    done
    [ "$cask" = "next" ] && cask="$lastarg"   # `brew install X --cask`
    if [ -z "$cask" ]; then
        if [ "$rpkg" -eq 1 ]; then
            die "--rpkg needs a cask: repkger brew install --cask --rpkg <name>"
        fi
        say "no --cask found; passing through to brew"
        exec brew "$@"
    fi

    command -v brew >/dev/null 2>&1 || die "brew not found on PATH"
    command -v curl >/dev/null 2>&1 || die "curl not found"

    say "== Checking cask '$cask' for a .pkg artifact =="
    local info url sha
    info=$(brew info --cask "$cask" --json=v2 2>/dev/null) || die "brew info failed for cask '$cask'"
    url=$(printf '%s' "$info" | python3 -c "import json,sys; d=json.load(sys.stdin); c=d['casks'][0]; print(c.get('url') or '')" 2>/dev/null || echo "")
    sha=$(printf '%s' "$info" | python3 -c "import json,sys; d=json.load(sys.stdin); c=d['casks'][0]; print(c.get('sha256') or '')" 2>/dev/null || echo "")

    local urlbase="${url%%[?#]*}"    # strip query/fragment for type + filename
    local is_pkg=0 is_dmg=0 is_zip=0
    case "$urlbase" in
        *.pkg|*.mpkg) is_pkg=1 ;;
        *.dmg) is_dmg=1 ;;
        *.zip) is_zip=1 ;;
    esac
    if [ "$is_pkg" -eq 0 ] && [ "$is_dmg" -eq 0 ] && [ "$is_zip" -eq 0 ]; then
        if [ "$rpkg" -eq 1 ]; then
            # forced mode must NEVER silently run brew's installer — fail loud
            die "cask '$cask' artifact is not a .pkg/.mpkg/.dmg/.zip (url: ${url:-unknown}); --rpkg only handles pkg artifacts (incl. a .pkg inside a dmg/zip)"
        fi
        say "cask '$cask' does not install a .pkg (url: ${url:-unknown}) — passing through to brew"
        exec brew "$@"
    fi

    say "cask '$cask' installs a .pkg: $url"
    if [ "$rpkg" -eq 1 ]; then
        say "=> --rpkg: forcing rootless repkger install (no installer, no sudo)"
    else
        say "=> intercepting with a rootless repkger install (no admin)"
    fi

    mkdir -p "$DOWNLOADS_DIR"
    local dl dsha got
    dl="$DOWNLOADS_DIR/$(basename "$urlbase")"
    if [ -f "$dl" ]; then
        dsha=$(sha256_of "$dl")
        if [ -n "$sha" ] && [ "$sha" != "no_check" ] && [ "$dsha" != "$sha" ]; then
            say "cached download mismatch; re-downloading"
            rm -f "$dl"
        else
            say "using cached download: $dl"
        fi
    fi
    if [ ! -f "$dl" ]; then
        say "downloading $url"
        curl -fL --retry 3 -C - -o "$dl" "$url" || die "download failed"
    fi
    if [ -n "$sha" ] && [ "$sha" != "no_check" ]; then
        got=$(sha256_of "$dl")
        [ "$got" = "$sha" ] || die "sha256 mismatch for $dl (got $got, expected $sha)"
        say "sha256 OK: $got"
    fi

    # resolve the actual .pkg to install — directly, or inside a dmg/zip
    # container (the download is verified; the inner pkg is read from the
    # mount/extract dir, which is cleaned up afterwards)
    trap cask_cleanup EXIT
    local pkgfile=""
    if [ "$is_pkg" -eq 1 ]; then
        pkgfile="$dl"
    else
        say "=> locating the .pkg inside $urlbase"
        CASK_STAGE=$(mktemp -d "${TMPDIR:-/tmp}/repkger-cask.XXXXXX")
        if [ "$is_dmg" -eq 1 ]; then
            CASK_MNT="$CASK_STAGE/mnt"
            mkdir -p "$CASK_MNT"
            hdiutil attach "$dl" -nobrowse -readonly -mountpoint "$CASK_MNT" >/dev/null 2>&1 \
                || die "could not mount $urlbase (hdiutil attach failed)"
            say "  mounted: $CASK_MNT"
            pkgfile=$(find "$CASK_MNT" -maxdepth 4 \( -name '*.pkg' -o -name '*.mpkg' \) 2>/dev/null | head -1)
        else
            if command -v unzip >/dev/null 2>&1; then
                unzip -o -q "$dl" -d "$CASK_STAGE" >/dev/null 2>&1 \
                    || die "could not unzip $urlbase"
            else
                ditto -x -k "$dl" "$CASK_STAGE" >/dev/null 2>&1 \
                    || die "could not unzip $urlbase (ditto)"
            fi
            pkgfile=$(find "$CASK_STAGE" -maxdepth 4 \( -name '*.pkg' -o -name '*.mpkg' \) 2>/dev/null | head -1)
        fi
        if [ -z "$pkgfile" ]; then
            cask_cleanup
            die "no .pkg/.mpkg found inside $urlbase — --rpkg needs a pkg artifact"
        fi
        say "  inner pkg: $pkgfile"
    fi

    echo ""
    "$0" install "$pkgfile" --home "$HOME" --yes ${MAP_ARGS[@]+"${MAP_ARGS[@]}"}
    cask_cleanup
    echo ""
    say "Done. Cask's own uninstall/zap (from homebrew) for reference:"
    printf '%s' "$info" | python3 -c "
import json,sys
d=json.load(sys.stdin); c=d['casks'][0]
for k in ('uninstall','zap'):
    if c.get(k): print(k+':', json.dumps(c[k]))
" 2>/dev/null || true
}

# ---------------------------------------------------------------------------
# gui
# ---------------------------------------------------------------------------
cmd_gui() {
    local app here
    here=$(cd "$(dirname "$0")" && pwd)
    app=""
    for app in "$here/../build/Repkger.app" "$here/../Repkger.app" "$HOME/Applications/Repkger.app" "/Applications/Repkger.app"; do
        [ -d "$app" ] && break
        app=""
    done
    if [ -n "$app" ]; then
        if [ $# -gt 0 ]; then
            # pass files as drops so the droplet's `on open` handles them
            exec open -a "$app" "$@"
        else
            exec open -a "$app"
        fi
    fi
    if command -v osascript >/dev/null 2>&1; then
        say "Repkger.app not found; falling back to a plain prompt"
        exec osascript -e 'on run argv
            set pkgPath to POSIX path of (choose file with prompt "Choose a .pkg to inspect or install:")
            do shell script "repkger inspect " & quoted form of pkgPath
        end run' "$@"
    fi
    die "Repkger.app not found (expected next to this script or in /Applications)"
}

# ---------------------------------------------------------------------------
# self-install (symlink + shell function)
# ---------------------------------------------------------------------------
cmd_self_install() {
    local shell_rc="$HOME/.zshrc"
    [ "${1:-}" = "--bash" ] && shell_rc="$HOME/.bashrc"
    local here script link
    here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
    script="$here/$(basename "${BASH_SOURCE[0]}")"
    link="$HOME/bin/repkger"

    mkdir -p "$HOME/bin"
    if [ -e "$link" ] && [ ! -L "$link" ]; then
        die "$link exists and is not a symlink — move it away first"
    fi
    ln -sfn "$script" "$link"
    say "linked: $link -> $script"

    local marker_start="# >>> repkger >>>"
    local marker_end="# <<< repkger <<<"
    local func_block
    func_block=$(cat <<'FUNC'

# >>> repkger >>>
# repkger brew wrapper — rootless .pkg installs for casks that ship a .pkg
brewpkg() {
  if command -v repkger >/dev/null 2>&1; then
    repkger brew "$@"
  else
    command brew "$@"
  fi
}
# use with e.g.:  brewpkg install --cask gamemaker

# brew() shim: `brew install --cask --rpkg <name>` forces the rootless
# repkger strategy for pkg casks (no installer, no sudo); every other brew
# call passes straight through to the real brew.
brew() {
  local a rpkg=0
  local -a args=()
  for a in "$@"; do
    if [ "$a" = "--rpkg" ]; then
      rpkg=1
    else
      args+=("$a")
    fi
  done
  if [ "$rpkg" -eq 1 ]; then
    if command -v repkger >/dev/null 2>&1; then
      command repkger brew "${args[@]}"
    else
      echo "brew: --rpkg needs repkger (see 'repkger self-install')" >&2
      return 1
    fi
  else
    command brew "$@"
  fi
}
# use with e.g.:  brew install --cask --rpkg gamemaker
# <<< repkger <<<
FUNC
)
    if [ -f "$shell_rc" ] && grep -qF "$marker_start" "$shell_rc"; then
        local tmp
        tmp=$(mktemp)
        awk -v s="$marker_start" -v e="$marker_end" '
            $0 == s { skip = 1; next }
            $0 == e { skip = 0; next }
            !skip { print }
        ' "$shell_rc" > "$tmp"
        cat >> "$tmp" <<EOF

$func_block
EOF
        mv "$tmp" "$shell_rc"
        say "updated brewpkg() in $shell_rc"
    else
        cat >> "$shell_rc" <<EOF

$func_block
EOF
        say "appended brewpkg() to $shell_rc"
    fi
    echo ""
    echo "=== repkger self-installed ==="
    echo "  CLI:      $link  (add $HOME/bin to your PATH if not already)"
    echo "  functions: brewpkg() + brew() shim in $shell_rc — open a new shell"
    echo "             to use them (brew() only intercepts --rpkg, passes everything else through)"
    echo ""
    echo "Examples:"
    echo "  repkger inspect ~/Downloads/GameMaker-2024.14.4.222.pkg"
    echo "  repkger install ~/Downloads/GameMaker-2024.14.4.222.pkg"
    echo "  brew install --cask --rpkg gamemaker   # force rootless pkg install"
    echo "  brewpkg install --cask gamemaker       # same, without the brew() shim"
    echo "  repkger uninstall com.yoyogames.gms2   # undo an install"
}

# ---------------------------------------------------------------------------
# usage / main
# ---------------------------------------------------------------------------
usage() {
    awk 'NR > 1 && /^#/ { print substr($0, 3) } NR > 1 && !/^#/ { exit }' "$0"
    exit "${1:-0}"
}

main() {
    [ $# -gt 0 ] || { usage 1; }
    local cmd="$1"; shift
    mkdir -p "$RECORDS_DIR" "$CACHE_DIR" "$DOWNLOADS_DIR" 2>/dev/null || true
    case "$cmd" in
        inspect)       cmd_inspect "$@" ;;
        install)       cmd_install "$@" ;;
        bom-redo)      cmd_bom_redo "$@" ;;
        uninstall)     cmd_uninstall "$@" ;;
        list)          cmd_list "$@" ;;
        brew)          cmd_brew "$@" ;;
        gui)           cmd_gui "$@" ;;
        self-install)  cmd_self_install "$@" ;;
        version|-v|--version) echo "repkger $REPKGER_VERSION"; exit 0 ;;
        help|-h|--help) usage 0 ;;
        *) die "unknown command: $cmd (try 'repkger help')" ;;
    esac
}

main "$@"
